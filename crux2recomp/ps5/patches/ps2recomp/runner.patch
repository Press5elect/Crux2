+        constexpr uint32_t kVersion = 1u;
+        constexpr size_t kMaxVariants = 4096u;
+        constexpr uint64_t kMaxBlobBytes = uint64_t{256} << 20u; // larger is not kept (memory for the copy)
+        constexpr size_t kGranitePrefix = VK_UUID_SIZE + sizeof(uint64_t);
+
+        struct Header
+        {
+            char magic[8];
+            uint32_t version;
+            uint32_t headerBytes;
+            uint32_t vendorID;
+            uint32_t deviceID;
+            uint32_t driverVersion;
+            uint32_t variantBytes; // sizeof(ParallelGS::ShadingVariant)
+            uint8_t pipelineCacheUUID[VK_UUID_SIZE];
+            uint64_t shaderSet; // ParallelGS::shader_set_fingerprint()
