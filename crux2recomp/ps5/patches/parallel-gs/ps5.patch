+bool GSRenderer::submit_pending_work()
+{
+	if (!device)
+		return false;
+	// Only command buffers count: the render pass being built (vertices in the attribute scratch, pending
+	// texture uploads) is untouched, flush_submit() only flushes what is before the current reservation.
+	// Not while a texture's analysis pass (which decides what of it its upload copies) is still to be recorded:
+	// it goes into binning_cmd when the render pass ends, and is ordered before the upload (in direct_cmd) only
+	// by being submitted in the same batch. Submitted early, the upload would run with nothing to copy and the
+	// pass would sample a texture never filled (a picture of dots).
+	if (!texture_analysis.empty())
+		return false;
+	if (!direct_cmd && !async_transfer_cmd && !triangle_setup_cmd && !clear_cmd && !heuristic_cmd && !binning_cmd)
+		return false;
+	flush_submit(0, false);
+	// Granite only queues a submission without a fence or semaphore: this hands it to the GPU (it neither ends
+	// the frame context nor recycles anything).
+	device->flush_frame();
+	return true;
+}
