@@ -19,6 +19,7 @@
 #include <algorithm>
 #include <cmath>
 #include <climits>
+#include <chrono>
 
 #if defined(__clang__)
 #pragma clang diagnostic ignored "-Wformat-security"
@@ -1081,10 +1082,17 @@ void GSRenderer::wait_timeline(uint64_t value)
 	if (enable_timestamps && device)
 		start_ts = device->write_calibrated_timestamp();
 
-	std::unique_lock<std::mutex> holder{timeline_lock};
-	timeline_cond.wait(holder, [this, value]() {
-		return timeline_value.load(std::memory_order_relaxed) >= value;
-	});
+	if (timeline_value.load(std::memory_order_acquire) < value)
+	{
+		// Crux2: only a real wait is timed (a clock read per call would be noise).
+		const auto start = std::chrono::steady_clock::now();
+		std::unique_lock<std::mutex> holder{timeline_lock};
+		timeline_cond.wait(holder, [this, value]() {
+			return timeline_value.load(std::memory_order_relaxed) >= value;
+		});
+		host_wait_ns += uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+				std::chrono::steady_clock::now() - start).count());
+	}
 
 	if (enable_timestamps && device)
 	{
@@ -1105,6 +1113,25 @@ uint64_t GSRenderer::query_timeline(const Vulkan::SemaphoreHolder &sem) const
 		return value;
 }
 
+uint64_t GSRenderer::consume_host_wait_ns()
+{
+	uint64_t ns = host_wait_ns;
+	host_wait_ns = 0;
+	return ns;
+}
+
+bool GSRenderer::submit_pending_work()
+{
+	if (!device)
+		return false;
+	// Only command buffers count: the render pass being built (vertices in the attribute scratch, pending
+	// texture uploads) is untouched, flush_submit() only flushes what is before the current reservation.
+	if (!direct_cmd && !async_transfer_cmd && !triangle_setup_cmd && !clear_cmd && !heuristic_cmd && !binning_cmd)
+		return false;
+	flush_submit(0);
+	return true;
+}
