 	total_stats.allocated_image_memory += stats.allocated_image_memory;
 	total_stats.num_copies += stats.num_copies;
@@ -1157,6 +1197,7 @@ void GSRenderer::flush_submit(uint64_t value)
 	total_stats.num_copy_barriers += stats.num_copy_barriers;
 	total_stats.num_copy_threads += stats.num_copy_threads;
 	stats = {};
+	}
 
 	flush_attribute_scratch(buffers.pos_scratch);
 	flush_attribute_scratch(buffers.attr_scratch);
@@ -1238,7 +1279,11 @@ void GSRenderer::flush_submit(uint64_t value)
 
 	// If we have a timeline trace, we'd like it to be somewhat readable.
 	// Only do garbage collection at frame boundaries.
-	if (!device->get_system_handles().timeline_trace_file)
+	// Crux2: never in the middle of a frame (end_frame = false): advancing the frame context frees, a few
+	// contexts later, what was released in this one, which the render pass being built may still draw with
+	// (textures, palettes, buffers): with submissions every fraction of a millisecond that came before the pass
+	// was even recorded, and the GPU drew from freed memory (a picture of dots, or a hang).
+	if (end_frame && !device->get_system_handles().timeline_trace_file)
 		device->next_frame_context();
 
 	log_timestamps();
