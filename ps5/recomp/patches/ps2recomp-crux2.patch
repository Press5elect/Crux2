+
+    bool CodeGenerator::isCrux2Interpreted(const Instruction &inst) const
+    {
+        const uint32_t op = inst.raw >> 26, fmt = (inst.raw >> 21) & 0x1F, fn = inst.raw & 0x3F;
+        if (op == OPCODE_MMI)
+            return true;
+        // the SA register (MFSA, MTSA, MTSAB, MTSAH): PCSX2 keeps it as a byte count, and the
+        // native code works on PCSX2's own register
+        if (op == OPCODE_SPECIAL && (fn == 0x28 || fn == 0x29))
+            return true;
+        if (op == OPCODE_REGIMM && (((inst.raw >> 16) & 0x1F) == 0x18 || ((inst.raw >> 16) & 0x1F) == 0x19))
+            return true;
+        // COP1's arithmetic (S format) and CVT.S (W format); moves, branches and loads stay translated
+        return op == OPCODE_COP1 && (fmt == 0x10 || (fmt == 0x14 && fn == 0x20));
     }
 
     std::string CodeGenerator::translateInstruction(const Instruction &inst, const MemoryAccessHint &memoryHint)
     {
+        // Crux2 mode: the MMI and FPU instructions run PCSX2's own interpreter code (Crux2's
+        // crux2_ee_interp.h), which is what Crux2's check mode compares against; the translations
+        // here differ from the processor in many of them (word orders, HI/LO, saturation, FPU clamping).
+        if (m_crux2Mode && isCrux2Interpreted(inst))
+            return fmt::format("CRUX2_EE(0x{:08X}u);", inst.raw);
         return InstructionTranslator(*this).translate(inst, memoryHint);
     }
 
