// Crux2 - NVIDIA Image Scaling's scaler and sharpener as Crux2 binds them.
// SPDX-License-Identifier: GPL-3.0+
//
// The work is NVIDIA's (NIS_Scaler.h, NVIDIA Image Scaling v1.0.3, MIT); this follows NVIDIA's
// NIS_Main.glsl with two changes. The constants (NVIDIA's NISConfig, 28 values) are push
// constants rather than a uniform buffer, and the output image has a format, so writing it needs
// no shaderStorageImageWriteWithoutFormat (which PCSX2 does not enable); OUT_FORMAT 2 is the
// unformatted image for a device that has it.
//
// ps5/tools/make-compute-fx.sh compiles it with NIS_SCALER 1 (scale by 1x..2x and sharpen) or 0
// (sharpen only, 1:1), NIS_USE_HALF_PRECISION 0 or 1, and OUT_FORMAT 0 (rgba8), 1 (rgba16f) or 2.
// Block sizes are NVIDIA's for AMD hardware (NISOptimizer, AMD_Generic): 32x24 a workgroup of 256
// threads when scaling, 32x32 when sharpening.

#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_samplerless_texture_functions : require
#if NIS_USE_HALF_PRECISION
#extension GL_EXT_shader_explicit_arithmetic_types : require
#endif

#define NIS_GLSL 1
#define NIS_BLOCK_WIDTH 32
#if NIS_SCALER
#define NIS_BLOCK_HEIGHT 24
#else
#define NIS_BLOCK_HEIGHT 32
#endif
#define NIS_THREAD_GROUP_SIZE 256

layout(push_constant, std430) uniform NISConstants
{
	float kDetectRatio;
	float kDetectThres;
	float kMinContrastRatio;
	float kRatioNorm;

	float kContrastBoost;
	float kEps;
	float kSharpStartY;
	float kSharpScaleY;

	float kSharpStrengthMin;
	float kSharpStrengthScale;
	float kSharpLimitMin;
	float kSharpLimitScale;

	float kScaleX;
	float kScaleY;

	float kDstNormX;
	float kDstNormY;
	float kSrcNormX;
	float kSrcNormY;

	uint kInputViewportOriginX;
	uint kInputViewportOriginY;
	uint kInputViewportWidth;
	uint kInputViewportHeight;

	uint kOutputViewportOriginX;
	uint kOutputViewportOriginY;
	uint kOutputViewportWidth;
	uint kOutputViewportHeight;

	float reserved0;
	float reserved1;
};

layout(set = 0, binding = 1) uniform sampler samplerLinearClamp;
layout(set = 0, binding = 2) uniform texture2D in_texture;
#if OUT_FORMAT == 0
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D out_texture;
#elif OUT_FORMAT == 1
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D out_texture;
#else
#extension GL_EXT_shader_image_load_formatted : require
layout(set = 0, binding = 3) uniform writeonly image2D out_texture;
#endif
#if NIS_SCALER
layout(set = 0, binding = 4) uniform texture2D coef_scaler;
layout(set = 0, binding = 5) uniform texture2D coef_usm;
#endif

// NIS writes whole blocks (32x24 or 32x32) whether or not the output ends inside one; a store
// past the end of an image is undefined in Vulkan without robustImageAccess, and the image may be
// larger than the picture. So the store is only made inside the output (the viewport constants
// NVScalerUpdateConfig fills are the output's size). NIS_Scaler.h takes this NVTEX_STORE in place
// of its own (Crux2's two-line change to it).
void Crux2Store(ivec2 pos, vec4 value)
{
	if (uint(pos.x) < kOutputViewportWidth && uint(pos.y) < kOutputViewportHeight)
		imageStore(out_texture, pos, value);
}
#define NVTEX_STORE(x, pos, v) Crux2Store(ivec2(pos), vec4(v))

#include "NIS_Scaler.h"

layout(local_size_x = NIS_THREAD_GROUP_SIZE) in;
void main()
{
#if NIS_SCALER
	NVScaler(gl_WorkGroupID.xy, gl_LocalInvocationID.x);
#else
	NVSharpen(gl_WorkGroupID.xy, gl_LocalInvocationID.x);
#endif
}
