+bool GSDeviceVK::HasFrameGen()
+{
+	// Not with the device: eight more pipelines to make before the first picture would be paid
+	// by everybody, and it is off unless asked for.
+	if (!m_fg_pipelines_tried)
+	{
+		m_fg_pipelines_tried = true;
+		CompileFrameGenPipelines();
+	}
+	return m_fg_pipelines[NUM_FRAMEGEN_PASSES - 1] != VK_NULL_HANDLE;
+}
+
+bool GSDeviceVK::DoFrameGenPass(u32 pass, GSTexture* dTex, GSTexture* const* sTex, u32 count, const GSVector4& params)
+{
+	if (pass >= NUM_FRAMEGEN_PASSES || m_fg_pipelines[pass] == VK_NULL_HANDLE || !dTex || count == 0 ||
+		count > 1 + NUM_UTILITY_EXTRA_SAMPLERS)
+	{
+		return false;
+	}
+
+	GL_PUSH("DoFrameGenPass %u", pass);
+
+	// (Layouts cannot change inside a render pass, so all of it before one begins.)
+	EndRenderPass();
+
+	GSTextureVK* const dTexVK = static_cast<GSTextureVK*>(dTex);
+	for (u32 i = 0; i < count; i++)
+	{
+		GSTextureVK* const tex = static_cast<GSTextureVK*>(sTex[i]);
+		if (!tex || tex == dTexVK)
+			return false;
+		tex->CommitClear();
+		tex->TransitionToLayout(GSTextureVK::Layout::ShaderReadOnly);
+		tex->SetUseFenceCounter(GetCurrentFenceCounter());
+	}
+	dTexVK->TransitionToLayout(GetCurrentCommandBuffer(), GSTextureVK::Layout::ColorAttachment);
+
+	// The shader's three rows: the size of the picture written, of the first one read, and u_params.
+	const float dw = static_cast<float>(dTex->GetWidth()), dh = static_cast<float>(dTex->GetHeight());
+	const float sw = static_cast<float>(sTex[0]->GetWidth()), sh = static_cast<float>(sTex[0]->GetHeight());
+	const float constants[12] = {dw, dh, 1.0f / dw, 1.0f / dh, sw, sh, 1.0f / sw, 1.0f / sh, params.x, params.y, params.z, params.w};
+	SetUtilityPushConstants(constants, sizeof(constants));
+
+	// The first picture is the utility pass's own; the others go with it (ApplyUtilityState).
+	m_utility_extra_count = count - 1;
+	for (u32 i = 1; i < count; i++)
+		m_utility_extra_textures[i - 1] = static_cast<GSTextureVK*>(sTex[i]);
+	m_dirty_flags |= DIRTY_FLAG_UTILITY_TEXTURE;
+
+	DoStretchRect(static_cast<GSTextureVK*>(sTex[0]), GSVector4(0.0f, 0.0f, 1.0f, 1.0f), dTexVK, GSVector4(dTex->GetRect()),
+		m_fg_pipelines[pass], Biln, true);
+	EndRenderPass();
+
+	m_utility_extra_count = 0;
+	m_utility_extra_textures = {};
+	dTexVK->TransitionToLayout(GSTextureVK::Layout::ShaderReadOnly);
+	return true;
+}
