+// PS5: FSR 1.0. Two pipelines over resources/shaders/vulkan/fsr1.glsl, made as the CAS ones are.
+void GSDeviceVK::CompileFSRPipelines()
+{
+	std::optional<std::string> fsr_source = ReadShaderSource("shaders/vulkan/fsr1.glsl");
+	if (!fsr_source.has_value() || !GetFSRShaderSource(&fsr_source.value()))
+	{
+		Console.Warning("VK: FSR 1's shaders are not in the resources: it is not available.");
+		return;
+	}
+
+	VkShaderModule vs = GetUtilityVertexShader(m_convert_source);
+	if (vs == VK_NULL_HANDLE)
+		return;
+	ScopedGuard vs_guard([this, &vs]() { vkDestroyShaderModule(m_device, vs, nullptr); });
+
+	Vulkan::GraphicsPipelineBuilder gpb;
+	SetPipelineProvokingVertex(m_features, gpb);
+	AddUtilityVertexAttributes(gpb);
+	gpb.SetPipelineLayout(m_utility_pipeline_layout);
+	gpb.SetDynamicViewportAndScissorState();
+	gpb.AddDynamicState(VK_DYNAMIC_STATE_BLEND_CONSTANTS);
+	gpb.AddDynamicState(VK_DYNAMIC_STATE_LINE_WIDTH);
+	gpb.SetNoCullRasterizationState();
+	gpb.SetNoBlendingState();
+	gpb.SetVertexShader(vs);
+	gpb.SetRenderPass(GetRenderPass(VK_FORMAT_R8G8B8A8_UNORM, VK_FORMAT_UNDEFINED, VK_ATTACHMENT_LOAD_OP_DONT_CARE), 0);
+
+	for (u32 pass = 0; pass < NUM_FSR_PIPELINES; pass++)
+	{
+		std::stringstream source_with_header;
+		AddMacro(source_with_header, "FSR_PASS", static_cast<int>(pass));
+		source_with_header << *fsr_source;
+
+		VkShaderModule mod = GetUtilityFragmentShader(source_with_header.str());
+		ScopedGuard mod_guard = [this, &mod]() {
+			if (mod != VK_NULL_HANDLE)
+				vkDestroyShaderModule(m_device, mod, nullptr);
+		};
+		if (mod != VK_NULL_HANDLE)
+		{
+			gpb.SetFragmentShader(mod);
+			m_fsr_pipelines[pass] = gpb.Create(m_device, g_vulkan_shader_cache->GetPipelineCache(true), false);
+		}
+		if (m_fsr_pipelines[pass] == VK_NULL_HANDLE)
+		{
+			Console.Warning("VK: FSR 1's pass %u could not be made: it is not available.", pass);
+			for (VkPipeline& it : m_fsr_pipelines)
+			{
+				if (it != VK_NULL_HANDLE)
+					vkDestroyPipeline(m_device, it, nullptr);
+				it = VK_NULL_HANDLE;
+			}
+			return;
+		}
+	}
+	Console.WriteLn("VK: FSR 1 is available.");
+}
+
+bool GSDeviceVK::DoFSR(GSTexture* sTex, GSTexture* mid, GSTexture* dTex, const std::array<u32, NUM_FSR_CONSTANTS>& constants)
+{
+	if (m_fsr_pipelines[0] == VK_NULL_HANDLE || m_fsr_pipelines[1] == VK_NULL_HANDLE)
+		return false;
+
+	GL_PUSH("DoFSR");
+
+	EndRenderPass();
+
+	GSTextureVK* const sTexVK = static_cast<GSTextureVK*>(sTex);
+	GSTextureVK* const midVK = static_cast<GSTextureVK*>(mid);
+	GSTextureVK* const dTexVK = static_cast<GSTextureVK*>(dTex);
+	const VkCommandBuffer cmdbuf = GetCurrentCommandBuffer();
+	const GSVector4 whole(0.0f, 0.0f, 1.0f, 1.0f);
+
+	// EASU: the picture as drawn, to the size it is shown at. (It reads with textureGather, which
+	// takes the four texels around a place whatever the sampler's filter is; the linear one is
+	// bound so that no driver has a reason to offset the place.)
+	sTexVK->TransitionToLayout(cmdbuf, GSTextureVK::Layout::ShaderReadOnly);
+	midVK->TransitionToLayout(cmdbuf, GSTextureVK::Layout::ColorAttachment);
+	SetUtilityPushConstants(constants.data(), 16 * sizeof(u32));
+	DoStretchRect(sTexVK, whole, midVK, GSVector4(mid->GetRect()), m_fsr_pipelines[0], Biln, true);
+	EndRenderPass();
+
+	// RCAS: sharpened at that size.
+	midVK->TransitionToLayout(GSTextureVK::Layout::ShaderReadOnly);
+	dTexVK->TransitionToLayout(GetCurrentCommandBuffer(), GSTextureVK::Layout::ColorAttachment);
+	SetUtilityPushConstants(constants.data() + 16, 4 * sizeof(u32));
+	DoStretchRect(midVK, whole, dTexVK, GSVector4(dTex->GetRect()), m_fsr_pipelines[1], Nearest, true);
+	EndRenderPass();
+	dTexVK->TransitionToLayout(GSTextureVK::Layout::ShaderReadOnly);
+
+	return true;
+}
