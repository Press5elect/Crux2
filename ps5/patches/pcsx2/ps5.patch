+#ifdef __PROSPERO__
+extern "C" void ps5px_log(const char* format, ...);
+#endif
+
+void GSDevice::FSR(GSTexture*& tex, GSVector4i& src_rect, GSVector4& src_uv, const GSVector4& draw_rect)
+{
+	const int dst_width = static_cast<int>(std::ceil(draw_rect.z - draw_rect.x));
+	const int dst_height = static_cast<int>(std::ceil(draw_rect.w - draw_rect.y));
+	if (dst_width <= 0 || dst_height <= 0 || src_rect.width() <= 0 || src_rect.height() <= 0)
+		return;
+
+	m_fsr_of = nullptr;
+	bool made = false;
+	for (GSTexture*& target : m_fsr)
+	{
+		if (target && target->GetWidth() == dst_width && target->GetHeight() == dst_height)
+			continue;
+		delete target;
+		target = CreateSurface(GSTexture::RenderTarget, dst_width, dst_height, 1, GSTexture::Format::Color);
+		if (!target)
+		{
+			Console.Error("GS: Failed to allocate FSR texture.");
+			return;
+		}
+		made = true;
+	}
+	// Said once for each size it enlarges to: what FSR does is otherwise not seen in any log.
+	if (made)
+	{
+		Console.WriteLn("GS: FSR 1 enlarges %dx%d to %dx%d", src_rect.width(), src_rect.height(), dst_width, dst_height);
+#ifdef __PROSPERO__
+		ps5px_log("picture: FSR 1 enlarges %dx%d to %dx%d", src_rect.width(), src_rect.height(), dst_width, dst_height);
+#endif
+	}
+
+	// The constants, as FsrEasuConOffset and FsrRcasCon of ffx_fsr1.h make them: the part of the
+	// texture the picture is in, the texture's size, and the size it is shown at.
+	const auto bits = [](float value) {
+		u32 out;
+		std::memcpy(&out, &value, sizeof(out));
+		return out;
+	};
+	const float in_w = static_cast<float>(src_rect.width()), in_h = static_cast<float>(src_rect.height());
+	const float tex_w = static_cast<float>(tex->GetWidth()), tex_h = static_cast<float>(tex->GetHeight());
+	const float out_w = static_cast<float>(dst_width), out_h = static_cast<float>(dst_height);
+	std::array<u32, NUM_FSR_CONSTANTS> consts = {};
+	consts[0] = bits(in_w / out_w);
+	consts[1] = bits(in_h / out_h);
+	consts[2] = bits(0.5f * in_w / out_w - 0.5f + static_cast<float>(src_rect.x));
+	consts[3] = bits(0.5f * in_h / out_h - 0.5f + static_cast<float>(src_rect.y));
+	consts[4] = bits(1.0f / tex_w);
+	consts[5] = bits(1.0f / tex_h);
+	consts[6] = bits(1.0f / tex_w);
+	consts[7] = bits(-1.0f / tex_h);
+	consts[8] = bits(-1.0f / tex_w);
+	consts[9] = bits(2.0f / tex_h);
+	consts[10] = bits(1.0f / tex_w);
+	consts[11] = bits(2.0f / tex_h);
+	consts[12] = bits(0.0f);
+	consts[13] = bits(4.0f / tex_h);
+	// RCAS counts its sharpness in halvings from the sharpest: the setting's 100% is none, 0% two.
+	const float stops = (1.0f - static_cast<float>(std::min<u8>(GSConfig.CAS_Sharpness, 100)) * 0.01f) * 2.0f;
+	consts[16] = bits(std::exp2(-stops));
+
+	if (!DoFSR(tex, m_fsr[0], m_fsr[1], consts))
+		return;
+
+	m_fsr_of = tex;
+	tex = m_fsr[1];
+	src_rect = GSVector4i(0, 0, dst_width, dst_height);
+	src_uv = GSVector4(0.0f, 0.0f, 1.0f, 1.0f);
+}
+
+GSTexture* GSDevice::LastFSR(GSTexture* tex, const GSVector4& draw_rect) const
+{
+	if (!tex || m_fsr_of != tex || !m_fsr[1])
+		return nullptr;
+	if (m_fsr[1]->GetWidth() != static_cast<int>(std::ceil(draw_rect.z - draw_rect.x)) ||
+		m_fsr[1]->GetHeight() != static_cast<int>(std::ceil(draw_rect.w - draw_rect.y)))
+		return nullptr;
+	return m_fsr[1];
+}
+
+// PS5: frame generation. A picture between two pictures of the game, made from the two pictures
+// alone (resources/shaders/vulkan/framegen.glsl says how). The order and the sizes here are the
+// ones ps5/tests/framegen/fg_test.c runs the same shaders in on a PC.
+void GSDevice::FrameGenReset()
+{
+	const auto drop = [](GSTexture*& t) {
+		delete t;
+		t = nullptr;
+	};
+	for (GSTexture*& t : m_fg_frames)
+		drop(t);
+	for (GSTexture*& t : m_fg_pairs)
+		drop(t);
+	for (GSTexture*& t : m_fg_moves)
+		drop(t);
+	for (GSTexture*& t : m_fg_ones)
+		drop(t);
+	drop(m_fg_made);
+	m_fg_newest = 0;
+	m_fg_count = 0;
+	m_fg_searched = false;
+}
+
+bool GSDevice::FrameGenPush(GSTexture* tex, const GSVector4& src_uv, const GSVector4& draw_rect, bool linear)
+{
+	const int width = static_cast<int>(std::ceil(draw_rect.z - draw_rect.x));
+	const int height = static_cast<int>(std::ceil(draw_rect.w - draw_rect.y));
+	// (A picture too small to halve six times is not one this is for.)
+	if (!HasFrameGen() || !tex || width < 256 || height < 128)
+	{
+		FrameGenReset();
+		return false;
+	}
+
+	if (!m_fg_frames[0] || m_fg_frames[0]->GetWidth() != width || m_fg_frames[0]->GetHeight() != height)
+	{
+		FrameGenReset();
+		const auto half = [](int size) { return std::max((size + 1) / 2, 1); };
+		bool ok = true;
+		const auto make = [this, &ok](int w, int h, GSTexture::Format format) {
+			GSTexture* const t = CreateSurface(GSTexture::RenderTarget, w, h, 1, format);
+			ok = ok && (t != nullptr);
+			if (t)
+				ClearRenderTarget(t, 0);
+			return t;
+		};
+		for (GSTexture*& t : m_fg_frames)
+			t = make(width, height, GSTexture::Format::Color);
+		m_fg_made = make(width, height, GSTexture::Format::Color);
+		// The pairs: a quarter, an eighth, a sixteenth, a thirty-second, a sixty-fourth.
+		int w = half(half(width)), h = half(half(height));
+		for (GSTexture*& t : m_fg_pairs)
+		{
+			t = make(w, h, GSTexture::Format::ColorHDR);
+			w = half(w);
+			h = half(h);
+		}
+		static constexpr u32 pair_of[7] = {4, 4, 4, 3, 2, 1, 1};
+		for (u32 i = 0; ok && i < 7; i++)
+			m_fg_moves[i] = make(m_fg_pairs[pair_of[i]]->GetWidth(), m_fg_pairs[pair_of[i]]->GetHeight(), GSTexture::Format::ColorHDR);
+		for (GSTexture*& t : m_fg_ones)
+			t = make(1, 1, GSTexture::Format::ColorHDR);
+		if (!ok)
+		{
+			Console.Error("GS: Failed to allocate the frame generation textures.");
+			FrameGenReset();
+			return false;
+		}
+		Console.WriteLn("GS: Frame generation works on pictures of %dx%d (moves searched in %dx%d blocks)", width, height,
+			m_fg_pairs[1]->GetWidth(), m_fg_pairs[1]->GetHeight());
+#ifdef __PROSPERO__
+		ps5px_log("picture: frame generation works on pictures of %dx%d (moves searched in %dx%d blocks)", width, height,
+			m_fg_pairs[1]->GetWidth(), m_fg_pairs[1]->GetHeight());
+#endif
+	}
+
+	m_fg_newest ^= 1;
+	GSTexture* const kept = m_fg_frames[m_fg_newest];
+	StretchRect(tex, src_uv, kept, GSVector4(kept->GetRect()), ShaderConvert::COPY, linear ? Biln : Nearest);
+	m_fg_count = std::min<u32>(m_fg_count + 1, 2);
+	m_fg_searched = false;
+	return true;
+}
+
+GSTexture* GSDevice::FrameGenMake(float time)
+{
+	if (m_fg_count < 2)
+		return FrameGenNewest();
+
+	GSTexture* const older = m_fg_frames[m_fg_newest ^ 1];
+	GSTexture* const newer = m_fg_frames[m_fg_newest];
+	GSTexture* const first64 = m_fg_moves[0];
+	GSTexture* const move64 = m_fg_moves[1];
+	GSTexture* const spread = m_fg_moves[2];
+	GSTexture* const move32 = m_fg_moves[3];
+	GSTexture* const move16 = m_fg_moves[4];
+	GSTexture* const move8 = m_fg_moves[5];
+	GSTexture* const moves = m_fg_moves[6];
+	GSTexture* const camera0 = m_fg_ones[0];
+	GSTexture* const camera = m_fg_ones[1];
+	GSTexture* const whole = m_fg_ones[2];
+
+	bool ok = true;
+	// (how: the shader's u_params.y; soft: its z; reach: its w.)
+	const auto pass = [this, &ok](u32 number, GSTexture* to, std::initializer_list<GSTexture*> from, float t = 0.0f, float how = 0.0f,
+						  float soft = 0.0f, float reach = 0.0f) {
+		ok = ok && DoFrameGenPass(number, to, from.begin(), static_cast<u32>(from.size()), GSVector4(t, how, soft, reach));
+	};
+
+	// Where everything went, once for each pair of pictures (several pictures between the two
+	// are made from the same answer).
+	if (!m_fg_searched)
+	{
+		pass(0, m_fg_pairs[0], {older, newer});
+		for (u32 i = 1; i < 5; i++)
+			pass(1, m_fg_pairs[i], {m_fg_pairs[i - 1]});
+		// The smallest pair: searched from nothing, the camera's move from that (the mean, then
+		// the mean of what is near it), and searched again from the camera's move. (The first
+		// runs are handed a picture they do not read.)
+		pass(2, first64, {m_fg_pairs[4], camera}, 0.0f, 0.0f, 1.0f, 4.0f);
+		pass(3, camera0, {first64, camera}, 0.0f, 0.0f);
+		pass(3, camera, {first64, camera0}, 0.0f, 1.0f);
+		pass(2, move64, {m_fg_pairs[4], camera}, 0.0f, 1.0f, 1.0f, 4.0f);
+		// Blocks that are not sure take the sure ones' answer: there and back.
+		pass(4, spread, {move64});
+		pass(4, move64, {spread});
+		// The larger pairs, each from the answer of the one before; the last one read as it is.
+		// (These two try the moves around their start two pixels apart, three each way.)
+		pass(2, move32, {m_fg_pairs[3], move64}, 0.0f, 1.0f, 2.0f, 3.0f);
+		pass(2, move16, {m_fg_pairs[2], move32}, 0.0f, 1.0f, 2.0f, 3.0f);
+		pass(2, move8, {m_fg_pairs[1], move16}, 0.0f, 2.0f, 0.0f, 1.0f);
+		pass(5, moves, {move8});
+		pass(6, whole, {moves, move8});
+		m_fg_searched = ok;
+	}
+
+	pass(7, m_fg_made, {older, newer, moves, whole}, time);
+	return ok ? m_fg_made : newer;
+}
+
+// PS5: the second way of making a picture between two: AMD FSR 3's optical flow and Crux2's
+// composite over it (ps5/frontend/ps5_compute_fx.h), on compute shaders, into a picture of its
+// own. Where that cannot be done the title's own passes make it, as with the first way.
+GSTexture* GSDevice::FrameGenMakeOpticalFlow(float time)
+{
+	if (m_fg_count < 2)
+		return FrameGenNewest();
+	GSTexture* const older = m_fg_frames[m_fg_newest ^ 1];
+	GSTexture* const newer = m_fg_frames[m_fg_newest];
+	if (!m_ofg_made || m_ofg_made->GetWidth() != newer->GetWidth() || m_ofg_made->GetHeight() != newer->GetHeight())
+	{
+		delete m_ofg_made;
+		m_ofg_made = CreateSurface(GSTexture::Usage::RenderTarget | GSTexture::Usage::ShaderWrite, newer->GetWidth(), newer->GetHeight(), 1,
+			GSTexture::Format::Color);
+	}
+	if (m_ofg_made && DoOpticalFlowMake(older, newer, m_ofg_made, time, std::min<u32>(GSConfig.FrameGenQuality, 2)))
+		return m_ofg_made;
+	return FrameGenMake(time);
+}
+
+// PS5: NVIDIA Image Scaling, where FSR 1 would be: the picture enlarged to its place on the
+// screen and sharpened, from 1x to 2x of its size. Further than 2x it is left to the bilinear
+// filter of the screen's pass (and said once).
+void GSDevice::NIS(GSTexture*& tex, GSVector4i& src_rect, GSVector4& src_uv, const GSVector4& draw_rect)
+{
+	const int dst_width = static_cast<int>(std::ceil(draw_rect.z - draw_rect.x));
+	const int dst_height = static_cast<int>(std::ceil(draw_rect.w - draw_rect.y));
+	const int in_w = src_rect.width(), in_h = src_rect.height();
+	if (dst_width <= 0 || dst_height <= 0 || in_w <= 0 || in_h <= 0)
+		return;
+	static bool s_said_far = false;
+	if (dst_width > in_w * 2 || dst_height > in_h * 2 || dst_width < in_w || dst_height < in_h)
+	{
+		if (!s_said_far)
+		{
+			s_said_far = true;
+#ifdef __PROSPERO__
+			ps5px_log("picture: NIS enlarges from 1x to 2x; %dx%d to %dx%d is left to the screen's filter", in_w, in_h, dst_width, dst_height);
+#endif
+		}
+		return;
+	}
+	// NIS reads a whole texture: a picture that is a part of its texture is copied out first.
+	GSTexture* input = tex;
+	if (src_rect.x != 0 || src_rect.y != 0 || in_w != tex->GetWidth() || in_h != tex->GetHeight())
+	{
+		if (!m_nis_in || m_nis_in->GetWidth() != in_w || m_nis_in->GetHeight() != in_h)
+		{
+			delete m_nis_in;
+			m_nis_in = CreateSurface(GSTexture::RenderTarget, in_w, in_h, 1, GSTexture::Format::Color);
+			if (!m_nis_in)
+				return;
+		}
+		CopyRect(tex, m_nis_in, src_rect, 0, 0);
+		input = m_nis_in;
+	}
+	if (!m_nis || m_nis->GetWidth() != dst_width || m_nis->GetHeight() != dst_height)
+	{
+		delete m_nis;
+		m_nis = CreateSurface(GSTexture::Usage::RenderTarget | GSTexture::Usage::ShaderWrite, dst_width, dst_height, 1, GSTexture::Format::Color);
+		if (!m_nis)
+			return;
+#ifdef __PROSPERO__
+		ps5px_log("picture: NIS enlarges %dx%d to %dx%d", in_w, in_h, dst_width, dst_height);
+#endif
+	}
+	const float sharpness = static_cast<float>(std::min<u8>(GSConfig.CAS_Sharpness, 100)) * 0.01f;
+	if (!DoNIS(input, m_nis, sharpness))
+		return;
+	tex = m_nis;
+	src_rect = GSVector4i(0, 0, dst_width, dst_height);
+	src_uv = GSVector4(0.0f, 0.0f, 1.0f, 1.0f);
+}
+
+// PS5: the look. The preset reads the picture as the game's own picture ("Original"): the part of
+// the texture it is in is copied out when it is not the whole texture.
+GSTexture* GSDevice::Look(GSTexture* tex, const GSVector4& src_uv, const GSVector4& draw_rect)
+{
+	const int dst_width = static_cast<int>(std::ceil(draw_rect.z - draw_rect.x));
+	const int dst_height = static_cast<int>(std::ceil(draw_rect.w - draw_rect.y));
+	if (!tex || dst_width <= 0 || dst_height <= 0)
+		return nullptr;
+	GSTexture* input = tex;
+	if (src_uv.x != 0.0f || src_uv.y != 0.0f || src_uv.z != 1.0f || src_uv.w != 1.0f)
+	{
+		const int w = std::max(1, static_cast<int>(std::round((src_uv.z - src_uv.x) * tex->GetWidth())));
+		const int h = std::max(1, static_cast<int>(std::round((src_uv.w - src_uv.y) * tex->GetHeight())));
+		if (!m_look_in || m_look_in->GetWidth() != w || m_look_in->GetHeight() != h)
+		{
+			delete m_look_in;
+			m_look_in = CreateSurface(GSTexture::RenderTarget, w, h, 1, GSTexture::Format::Color);
+			if (!m_look_in)
+				return nullptr;
+		}
+		StretchRect(tex, src_uv, m_look_in, GSVector4(m_look_in->GetRect()), ShaderConvert::COPY, Nearest);
+		input = m_look_in;
+	}
+	if (!m_look || m_look->GetWidth() != dst_width || m_look->GetHeight() != dst_height)
+	{
+		delete m_look;
+		m_look = CreateSurface(GSTexture::RenderTarget, dst_width, dst_height, 1, GSTexture::Format::Color);
+		if (!m_look)
+			return nullptr;
+	}
+	if (!DoLook(input, m_look, m_look_frames++))
+		return nullptr;
+	return m_look;
+}
+
+// PS5: the picture beside a 4:3 one: the game's picture made small (a sixteenth), softened and
+// darkened by framegen.glsl's pass 8, and stretched over the whole screen under the picture.
+GSTexture* GSDevice::SidePicture(GSTexture* tex, const GSVector4& src_uv, const GSVector4& draw_rect)
+{
+	const int screen_w = GetWindowWidth(), screen_h = GetWindowHeight();
+	if (!tex || screen_w <= 0 || screen_h <= 0 || (draw_rect.x < 8.0f && draw_rect.y < 8.0f))
+		return nullptr;
+	if (!HasFrameGen()) // (the pass is one of frame generation's)
+		return nullptr;
+	const int w = std::max(8, screen_w / 24), h = std::max(8, screen_h / 24);
+	for (GSTexture*& t : m_side)
+	{
+		if (t && t->GetWidth() == w && t->GetHeight() == h)
+			continue;
+		delete t;
+		t = CreateSurface(GSTexture::RenderTarget, w, h, 1, GSTexture::Format::Color);
+		if (!t)
+			return nullptr;
+	}
+	StretchRect(tex, src_uv, m_side[0], GSVector4(m_side[0]->GetRect()), ShaderConvert::COPY, Biln);
+	GSTexture* const from[1] = {m_side[0]};
+	if (!DoFrameGenPass(8, m_side[1], from, 1, GSVector4(0.35f, 0.0f, 0.0f, 0.0f)))
+		return nullptr;
+	return m_side[1];
+}
+
+void GSDevice::PS5PictureReset()
+{
+	for (GSTexture** t : {&m_ofg_made, &m_nis, &m_nis_in, &m_look, &m_look_in, &m_side[0], &m_side[1]})
+	{
+		delete *t;
+		*t = nullptr;
+	}
+}
