+	Error error;
+	std::vector<u8> data;
+	std::string failure;
+	if (!SaveState_ZipToMemory(std::move(elist), std::move(screenshot), zstd_level, &data, &error))
+	{
+		failure = error.GetDescription();
+	}
+	else if (!filename.empty())
+	{
+		const std::string beside = filename + ".tmp";
+		if (!FileSystem::WriteBinaryFile(beside.c_str(), data.data(), data.size()) || !FileSystem::RenamePath(beside.c_str(), filename.c_str()))
+		{
+			FileSystem::DeleteFilePath(beside.c_str());
+			failure = "the state could not be written to " + filename;
+		}
+		else
+		{
+			Host::OnSaveStateSaved(filename);
+		}
+	}
+	done(std::move(data), std::move(failure));
+
+	// remove ourselves from the thread list. if we're joining, we might not be in there.
+	const auto this_id = std::this_thread::get_id();
+	std::unique_lock lock(s_save_state_threads_mutex);
+	for (auto it = s_save_state_threads.begin(); it != s_save_state_threads.end(); ++it)
+	{
+		if (it->get_id() == this_id)
+		{
+			it->detach();
+			s_save_state_threads.erase(it);
+			break;
+		}
+	}
