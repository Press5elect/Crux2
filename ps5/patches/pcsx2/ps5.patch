+
+static void mVUemitLowerSoftCacheSetAddress(const microVUSoftLowerCacheSet* cache)
+{
+	xSHL(ecx, 6);
+	xMOV64(r11, reinterpret_cast<uptr>(cache));
+	xADD(r11, rcx);
