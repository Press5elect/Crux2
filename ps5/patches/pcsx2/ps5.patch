+		{
+			constexpr sptr scalar_result_offset = 0;
+			constexpr int scalar_stack_size = (sizeof(VuSoftFmacJitResult) + 15) & ~15;
+			const auto scalarResultPtr = [](int offset) {
+				return ptr32[rsp + scalar_result_offset + offset];
+			};
