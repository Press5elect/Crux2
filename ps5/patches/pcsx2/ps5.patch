+// PS5: AMD FidelityFX Super Resolution 1.0 (resources/shaders/vulkan/fsr1.glsl has the passes).
+bool GSDevice::GetFSRShaderSource(std::string* source)
+{
+	std::optional<std::string> ffx_a_source = ReadShaderSource("shaders/common/fsr1/ffx_a.h");
+	std::optional<std::string> ffx_fsr_source = ReadShaderSource("shaders/common/fsr1/ffx_fsr1.h");
+	if (!ffx_a_source.has_value() || !ffx_fsr_source.has_value())
+		return false;
+
+	StringUtil::ReplaceAll(source, "#include \"fsr1/ffx_a.h\"", ffx_a_source.value());
+	StringUtil::ReplaceAll(source, "#include \"fsr1/ffx_fsr1.h\"", ffx_fsr_source.value());
+	return true;
+}
