+// Crux2 v1.0.19: a state zipped into memory at zstd level `zstd_level`: the safety save is held
+// there and written to the drive only when it is needed (ps5_extras.cpp). The bytes are the file a
+// state on disk would be.
+bool SaveState_ZipToMemory(std::unique_ptr<ArchiveEntryList> srclist, std::unique_ptr<SaveStateScreenshotData> screenshot,
+	int zstd_level, std::vector<u8>* out, Error* error)
+{
+	zip_error_t ze = {};
+	zip_source_t* const zs = zip_source_buffer_create(nullptr, 0, 0, &ze);
+	if (!zs)
+	{
+		Error::SetStringFmt(error, "Failed to make a buffer for the save state: {}.", zip_error_strerror(&ze));
+		return false;
+	}
+	zip_source_keep(zs); // (it outlives the archive: the bytes are read from it after the close)
+	zip_t* const zf = zip_open_from_source(zs, ZIP_CREATE | ZIP_TRUNCATE, &ze);
+	if (!zf)
+	{
+		Error::SetStringFmt(error, "Failed to open a zip in memory for the save state: {}.", zip_error_strerror(&ze));
+		zip_source_free(zs); // (kept: two references)
+		zip_source_free(zs);
+		return false;
+	}
+	s_ps5_zstd_level = zstd_level;
+	const bool added = SaveState_AddToZip(zf, srclist.get(), screenshot.get());
+	s_ps5_zstd_level = -1;
+	if (!added)
+	{
+		Error::SetString(error, "Failed to save the state into memory.");
+		zip_discard(zf);
+		zip_source_free(zs);
+		return false;
+	}
+	if (zip_close(zf) != 0)
+	{
+		Error::SetStringFmt(error, "Failed to save the state into memory: {}.", zip_strerror(zf));
+		zip_discard(zf);
+		zip_source_free(zs);
+		return false;
+	}
+	bool ok = false;
+	if (zip_source_open(zs) == 0)
+	{
+		if (zip_source_seek(zs, 0, SEEK_END) == 0)
+		{
+			const zip_int64_t size = zip_source_tell(zs);
+			if (size > 0 && zip_source_seek(zs, 0, SEEK_SET) == 0)
+			{
+				out->resize(static_cast<size_t>(size));
+				ok = zip_source_read(zs, out->data(), static_cast<zip_uint64_t>(size)) == size;
+			}
+		}
+		zip_source_close(zs);
+	}
+	zip_source_free(zs);
+	if (!ok)
+	{
+		out->clear();
+		Error::SetString(error, "Failed to read the state back out of memory.");
+	}
+	return ok;
+}
