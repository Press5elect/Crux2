+struct GSDeviceVK::PS5Tools
+{
+	PS5ComputeFX::OpticalFlowFG flow;
+	bool flow_failed = false;
+	u32 flow_quality = 0xffffffffu;
+	PS5ComputeFX::NIS nis;
+	bool nis_failed = false;
+
+	PS5SlangRunner::Device chain_device;
+	PS5Slang::Preset preset;
+	std::unique_ptr<PS5SlangRunner::Runner> chain;
+	std::string chain_path; // what is loaded ("" nothing)
+	std::string chain_failed; // what failed to load, not tried again until the setting changes
+
+	// paraLLEl-GS's pictures in its host memory, imported (PS5CopyHostPicture), by allocation id.
+	struct HostImport
+	{
+		const void* host = nullptr;
+		size_t bytes = 0;
+		u64 id = 0;
+		VkBuffer buffer = VK_NULL_HANDLE;
+		VkDeviceMemory memory = VK_NULL_HANDLE;
+	};
+	std::vector<HostImport> host_imports;
+	bool host_checked = false;
+	size_t host_align = 0; // 0: no import
+	PFN_vkGetMemoryHostPointerPropertiesEXT host_pointer_properties = nullptr;
+};
+
+GSDeviceVK::PS5Tools& GSDeviceVK::Tools()
+{
+	if (!m_ps5_tools)
+		m_ps5_tools = new PS5Tools();
+	return *m_ps5_tools;
+}
+
+void GSDeviceVK::DestroyPS5Tools()
+{
+	if (!m_ps5_tools)
+		return;
+	vkDeviceWaitIdle(m_device);
+	for (const PS5Tools::HostImport& imp : m_ps5_tools->host_imports)
+	{
+		vkDestroyBuffer(m_device, imp.buffer, nullptr);
+		vkFreeMemory(m_device, imp.memory, nullptr);
+	}
+	m_ps5_tools->chain.reset();
+	m_ps5_tools->flow.Destroy();
+	m_ps5_tools->nis.Destroy();
+	delete m_ps5_tools;
+	m_ps5_tools = nullptr;
+}
+
+static PS5ComputeFX::Device ComputeDevice(VkPhysicalDevice physical, VkDevice device)
+{
+	PS5ComputeFX::Device d;
+	d.physicalDevice = physical;
+	d.device = device;
+	d.pipelineCache = g_vulkan_shader_cache->GetPipelineCache(true);
+	// Three command buffers, each with up to two pictures shown, and slack.
+	d.framesInFlight = GSDeviceVK::NUM_COMMAND_BUFFERS * 4;
+	return d;
+}
+
+// ---- paraLLEl-GS's pictures from its host memory --------------------------------------------------------------
+// paraLLEl-GS (ps5/frontend/ps5_pgs.cpp) reads each picture back into anonymous memory it imported into its own
+// device; the same memory is imported here (the driver gives it GPU access at the CPU's address) and the picture
+// copied into a texture by the graphics card: no copy through the processor, and none through the upload buffer.
+// Both devices' work goes through the console's one GPU queue in order. needs proper testing on a console
+
+size_t GSDeviceVK::PS5HostImportAlignment()
+{
+	PS5Tools& t = Tools();
+	if (t.host_checked)
+		return t.host_align;
+	t.host_checked = true;
+	if (!m_optional_extensions.vk_ext_external_memory_host)
+	{
+		ps5px_log("picture: the driver cannot import host memory: paraLLEl-GS's pictures go through the processor");
+		return 0;
+	}
+	t.host_pointer_properties = reinterpret_cast<PFN_vkGetMemoryHostPointerPropertiesEXT>(
+		vkGetDeviceProcAddr(m_device, "vkGetMemoryHostPointerPropertiesEXT"));
+	VkPhysicalDeviceExternalMemoryHostPropertiesEXT host = {VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_EXTERNAL_MEMORY_HOST_PROPERTIES_EXT};
+	VkPhysicalDeviceProperties2 props = {VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2};
+	props.pNext = &host;
+	vkGetPhysicalDeviceProperties2(m_physical_device, &props);
+	if (!t.host_pointer_properties || host.minImportedHostPointerAlignment == 0)
+	{
+		ps5px_log("picture: the driver's host memory import is incomplete: paraLLEl-GS's pictures go through the processor");
+		return 0;
+	}
+	t.host_align = static_cast<size_t>(host.minImportedHostPointerAlignment);
+	ps5px_log("picture: paraLLEl-GS's pictures can be imported from its memory (alignment %zu)", t.host_align);
+	return t.host_align;
+}
+
+bool GSDeviceVK::PS5CopyHostPicture(const void* host, size_t bytes, u64 id, GSTexture* dst, u32 width, u32 height)
+{
+	const size_t align = PS5HostImportAlignment();
+	if (!align || !host || !dst || (reinterpret_cast<uintptr_t>(host) % align) != 0 || (bytes % align) != 0 ||
+		bytes < static_cast<size_t>(width) * height * 4u || dst->GetWidth() < static_cast<int>(width) ||
+		dst->GetHeight() < static_cast<int>(height))
+		return false;
+
+	PS5Tools& t = Tools();
+	VkBuffer buffer = VK_NULL_HANDLE;
+	for (const PS5Tools::HostImport& imp : t.host_imports)
+	{
+		if (imp.id == id && imp.host == host && imp.bytes == bytes)
+		{
+			buffer = imp.buffer;
+			break;
+		}
+	}
+	if (buffer == VK_NULL_HANDLE)
+	{
+		VkMemoryHostPointerPropertiesEXT pointer = {VK_STRUCTURE_TYPE_MEMORY_HOST_POINTER_PROPERTIES_EXT};
+		VkResult res = t.host_pointer_properties(m_device, VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT, host, &pointer);
+		if (res != VK_SUCCESS)
+		{
+			ps5px_log("picture: paraLLEl-GS's memory is not importable (vkGetMemoryHostPointerPropertiesEXT: %d)", static_cast<int>(res));
+			return false;
+		}
+		VkExternalMemoryBufferCreateInfo external = {VK_STRUCTURE_TYPE_EXTERNAL_MEMORY_BUFFER_CREATE_INFO};
+		external.handleTypes = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT;
+		VkBufferCreateInfo bci = {VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+		bci.pNext = &external;
+		bci.size = bytes;
+		bci.usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT;
+		bci.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+		res = vkCreateBuffer(m_device, &bci, nullptr, &buffer);
+		if (res != VK_SUCCESS)
+		{
+			ps5px_log("picture: no buffer for paraLLEl-GS's memory (vkCreateBuffer: %d)", static_cast<int>(res));
+			return false;
+		}
+		VkMemoryRequirements req;
+		vkGetBufferMemoryRequirements(m_device, buffer, &req);
+		VkPhysicalDeviceMemoryProperties mem;
+		vkGetPhysicalDeviceMemoryProperties(m_physical_device, &mem);
+		// A type the pointer can be imported as, host-visible first (the memory is the CPU's).
+		const u32 bits = req.memoryTypeBits & pointer.memoryTypeBits;
+		u32 type = UINT32_MAX;
+		for (u32 pass = 0; pass < 2 && type == UINT32_MAX; pass++)
+		{
+			for (u32 i = 0; i < mem.memoryTypeCount; i++)
+			{
+				if ((bits & (1u << i)) &&
+					(pass == 1 || (mem.memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT)))
+				{
+					type = i;
+					break;
+				}
+			}
+		}
+		VkImportMemoryHostPointerInfoEXT import = {VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT};
+		import.handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_HOST_ALLOCATION_BIT_EXT;
+		import.pHostPointer = const_cast<void*>(host);
+		VkMemoryAllocateInfo mai = {VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+		mai.pNext = &import;
+		mai.allocationSize = bytes;
+		mai.memoryTypeIndex = type;
+		VkDeviceMemory memory = VK_NULL_HANDLE;
+		res = (type == UINT32_MAX) ? VK_ERROR_INVALID_EXTERNAL_HANDLE : vkAllocateMemory(m_device, &mai, nullptr, &memory);
+		if (res == VK_SUCCESS)
+			res = vkBindBufferMemory(m_device, buffer, memory, 0);
+		if (res != VK_SUCCESS)
+		{
+			ps5px_log("picture: paraLLEl-GS's memory could not be imported (%d)", static_cast<int>(res));
+			vkDestroyBuffer(m_device, buffer, nullptr);
+			if (memory != VK_NULL_HANDLE)
+				vkFreeMemory(m_device, memory, nullptr);
+			return false;
+		}
+		t.host_imports.push_back({host, bytes, id, buffer, memory});
+	}
+
+	GSTextureVK* const tex = static_cast<GSTextureVK*>(dst);
+	tex->PS5UpdateFromBuffer(buffer, width, height);
+	return true;
+}
+
+void GSDeviceVK::PS5ForgetHostPictures(bool now)
+{
+	if (!m_ps5_tools || m_ps5_tools->host_imports.empty())
+		return;
+	std::vector<PS5Tools::HostImport> imports = std::move(m_ps5_tools->host_imports);
+	m_ps5_tools->host_imports.clear();
+	if (now)
+	{
+		ExecuteCommandBuffer(true, "paraLLEl-GS's pictures let go of");
+		for (const PS5Tools::HostImport& imp : imports)
+		{
+			vkDestroyBuffer(m_device, imp.buffer, nullptr);
+			vkFreeMemory(m_device, imp.memory, nullptr);
+		}
+		return;
+	}
+	FrameResources& resources = m_frame_resources[m_current_frame];
+	resources.cleanup_resources.push_back([this, imports = std::move(imports)]() {
+		for (const PS5Tools::HostImport& imp : imports)
+		{
+			vkDestroyBuffer(m_device, imp.buffer, nullptr);
+			vkFreeMemory(m_device, imp.memory, nullptr);
+		}
+	});
+}
+
+u64 GSDeviceVK::PS5PollCompletedFenceCounter()
+{
+	ScanForCommandBufferCompletion();
+	return m_completed_fence_counter;
+}
+
+bool GSDeviceVK::DoOpticalFlowMake(GSTexture* older, GSTexture* newer, GSTexture* out, float time, u32 quality)
+{
+	PS5Tools& t = Tools();
+	if (t.flow_failed || !older || !newer || !out)
+		return false;
+	const u32 w = static_cast<u32>(out->GetWidth()), h = static_cast<u32>(out->GetHeight());
+	if (!t.flow.IsCreated() || t.flow.Width() != w || t.flow.Height() != h || t.flow_quality != quality)
+	{
+		if (t.flow.IsCreated())
+		{
+			ExecuteCommandBuffer(true, "optical flow resized");
+			t.flow.Destroy();
+		}
+		if (!t.flow.Create(ComputeDevice(m_physical_device, m_device), w, h, VK_FORMAT_R8G8B8A8_UNORM,
+				static_cast<PS5ComputeFX::Quality>(std::min<u32>(quality, 2))))
+		{
+			ps5px_log("picture: AMD FSR 3's optical flow could not be made (%s): the title's own frame generation makes the pictures", t.flow.LastError());
+			t.flow_failed = true;
+			return false;
+		}
+		t.flow_quality = quality;
+		ps5px_log("picture: AMD FSR 3's optical flow works on %ux%u (the flow at %ux%u, %u levels, %.1f MB)", w, h, t.flow.FlowWidth(),
+			t.flow.FlowHeight(), t.flow.Levels(), static_cast<double>(t.flow.MemoryBytes()) / 1048576.0);
+	}
+
+	EndRenderPass();
+	GSTextureVK* const a = static_cast<GSTextureVK*>(older);
+	GSTextureVK* const b = static_cast<GSTextureVK*>(newer);
+	GSTextureVK* const o = static_cast<GSTextureVK*>(out);
+	for (GSTextureVK* tex : {a, b})
+	{
+		tex->CommitClear();
+		tex->TransitionToLayout(GSTextureVK::Layout::ShaderReadOnly);
+		tex->SetUseFenceCounter(GetCurrentFenceCounter());
+	}
+	o->TransitionToLayout(GSTextureVK::Layout::ComputeReadWriteImage);
+	o->SetUseFenceCounter(GetCurrentFenceCounter());
+
+	PS5ComputeFX::FrameGenInput in;
+	in.previous = a->GetView();
+	in.current = b->GetView();
+	in.output = o->GetView();
+	in.t = time;
+	in.showCurrentOnCut = true;
+	if (!t.flow.Record(GetCurrentCommandBuffer(), in))
+	{
+		ps5px_log("picture: AMD FSR 3's optical flow failed (%s): the title's own frame generation makes the pictures", t.flow.LastError());
+		t.flow_failed = true;
+		return false;
+	}
+	// (The module records its own barriers; the pipeline state PCSX2 had bound is gone.)
+	InvalidateCachedState();
+	return true;
+}
+
+bool GSDeviceVK::DoNIS(GSTexture* sTex, GSTexture* dTex, float sharpness)
+{
+	PS5Tools& t = Tools();
+	if (t.nis_failed || !sTex || !dTex)
+		return false;
+	if (!t.nis.IsCreated())
+	{
+		if (!t.nis.Create(ComputeDevice(m_physical_device, m_device), VK_FORMAT_R8G8B8A8_UNORM))
+		{
+			ps5px_log("picture: NVIDIA Image Scaling could not be made (%s): the picture is enlarged without it", t.nis.LastError());
+			t.nis_failed = true;
+			return false;
+		}
+		ps5px_log("picture: NVIDIA Image Scaling is ready (%s precision)", t.nis.UsesHalfPrecision() ? "half" : "full");
+	}
+	EndRenderPass();
+	GSTextureVK* const s = static_cast<GSTextureVK*>(sTex);
+	GSTextureVK* const d = static_cast<GSTextureVK*>(dTex);
+	s->CommitClear();
+	s->TransitionToLayout(GSTextureVK::Layout::ShaderReadOnly);
+	s->SetUseFenceCounter(GetCurrentFenceCounter());
+	d->TransitionToLayout(GSTextureVK::Layout::ComputeReadWriteImage);
+	d->SetUseFenceCounter(GetCurrentFenceCounter());
+	PS5ComputeFX::NISInput in;
+	in.input = s->GetView();
+	in.inputWidth = static_cast<u32>(sTex->GetWidth());
+	in.inputHeight = static_cast<u32>(sTex->GetHeight());
+	in.output = d->GetView();
+	in.outputWidth = static_cast<u32>(dTex->GetWidth());
+	in.outputHeight = static_cast<u32>(dTex->GetHeight());
+	in.sharpness = sharpness;
+	if (!t.nis.Record(GetCurrentCommandBuffer(), in))
+	{
+		ps5px_log("picture: NVIDIA Image Scaling failed (%s): the picture is enlarged without it", t.nis.LastError());
+		t.nis_failed = true;
+		return false;
+	}
+	InvalidateCachedState();
+	return true;
+}
+
+// The files of a preset: the title's own under resources/shaders/slang, or one of the user's (a
+// path on a USB drive or in the title folder), read through PCSX2's file system (which also
+// reaches the shares).
+static bool ReadPresetFile(void*, const std::string& path, size_t max_bytes, std::string& out, std::string& error)
+{
+	const std::optional<std::string> data = FileSystem::ReadFileToString(path.c_str());
+	if (!data.has_value())
+	{
+		error = "cannot read " + path;
+		return false;
+	}
+	if (data->size() > max_bytes)
+	{
+		error = path + " is too large";
+		return false;
+	}
+	out = std::move(*data);
+	return true;
+}
+
+bool GSDeviceVK::LoadLook(const std::string& name, std::string* error)
+{
+	PS5Tools& t = Tools();
+	const std::string slang_root = Path::Combine(EmuFolders::Resources, "shaders/slang");
+	const std::string path = name.empty() ? std::string() : (Path::IsAbsolute(name) ? name : Path::Combine(slang_root, name));
+	if (path == t.chain_path && t.chain)
+		return true;
+	if (!path.empty() && path == t.chain_failed)
+	{
+		if (error)
+			*error = "it did not load before";
+		return false;
+	}
+	if (t.chain)
+	{
+		ExecuteCommandBuffer(true, "look changed");
+		t.chain.reset();
+	}
+	t.chain_path.clear();
+	t.preset = PS5Slang::Preset();
+	if (path.empty())
+		return true;
+
+	PS5Slang::LoadOptions options;
+	options.allowedRoots = {slang_root, std::string(Path::GetDirectory(path))};
+	// (A user's preset from a collection names "../" a lot: its collection's top, a few folders up.)
+	std::string up(Path::GetDirectory(path));
+	for (int i = 0; i < 3 && !up.empty(); i++)
+		up = std::string(Path::GetDirectory(up));
+	if (!up.empty())
+		options.allowedRoots.push_back(up);
+	options.files.read = ReadPresetFile;
+	std::string why;
+	if (!PS5Slang::LoadPreset(path, options, t.preset, why))
+	{
+		ps5px_log("picture: the look %s cannot be used: %s", Path::GetFileName(path).data(), why.c_str());
+		t.chain_failed = path;
+		if (error)
+			*error = why;
+		return false;
+	}
+
+	// The lookup pictures (PNG), decoded.
+	std::vector<std::vector<uint8_t>> lut_pixels;
+	for (PS5Slang::Lut& lut : t.preset.luts)
+	{
+		RGBA8Image image;
+		if (!image.LoadFromBuffer(lut.path.c_str(), lut.data.data(), lut.data.size()))
+		{
+			why = "its picture " + lut.name + " cannot be read";
+			ps5px_log("picture: the look %s cannot be used: %s", Path::GetFileName(path).data(), why.c_str());
+			t.chain_failed = path;
+			if (error)
+				*error = why;
+			return false;
+		}
+		lut.width = image.GetWidth();
+		lut.height = image.GetHeight();
+		const u8* px = reinterpret_cast<const u8*>(image.GetPixels());
+		lut_pixels.emplace_back(px, px + static_cast<size_t>(lut.width) * lut.height * 4);
+		lut.data.clear();
+	}
+
+	t.chain_device.physical = m_physical_device;
+	t.chain_device.device = m_device;
+	vkGetPhysicalDeviceMemoryProperties(m_physical_device, &t.chain_device.memory);
+	t.chain_device.uniformAlign = std::max<VkDeviceSize>(m_device_properties.limits.minUniformBufferOffsetAlignment, 16);
+	t.chain = std::make_unique<PS5SlangRunner::Runner>(t.chain_device, t.preset, g_vulkan_shader_cache->GetPipelineCache(true));
+
+	EndRenderPass();
+	const auto compile = [](const std::string& glsl, bool vertex, size_t) -> VkShaderModule {
+		return vertex ? g_vulkan_shader_cache->GetVertexShader(glsl) : g_vulkan_shader_cache->GetFragmentShader(glsl);
+	};
+	if (!t.chain->Load(GetCurrentCommandBuffer(), compile, lut_pixels))
+	{
+		why = t.chain->error;
+		ExecuteCommandBuffer(true, "look failed");
+		t.chain.reset();
+		ps5px_log("picture: the look %s cannot be used: %s", Path::GetFileName(path).data(), why.c_str());
+		t.chain_failed = path;
+		if (error)
+			*error = why;
+		return false;
+	}
+	// (The lookup pictures' uploads are in this command buffer: submitted before the first frame.)
+	ExecuteCommandBuffer(true, "look loaded");
+	t.chain_path = path;
+	t.chain_failed.clear();
+	ps5px_log("picture: the look %s: %zu passes, %zu pictures of its own, %zu settings", Path::GetFileName(path).data(), t.preset.passes.size(),
+		t.preset.luts.size(), t.preset.parameters.size());
+	return true;
+}
+
+bool GSDeviceVK::DoLook(GSTexture* sTex, GSTexture* dTex, u64 frame)
+{
+	if (!LoadLook(GSConfig.PS5Look, nullptr))
+		return false;
+	PS5Tools& t = Tools();
+	if (!t.chain || !sTex || !dTex)
+		return false;
+
+	EndRenderPass();
+	GSTextureVK* const s = static_cast<GSTextureVK*>(sTex);
+	GSTextureVK* const d = static_cast<GSTextureVK*>(dTex);
+	s->CommitClear();
+	s->TransitionToLayout(GSTextureVK::Layout::ShaderReadOnly);
+	s->SetUseFenceCounter(GetCurrentFenceCounter());
+
+	const VkCommandBuffer cmd = GetCurrentCommandBuffer();
+	if (!t.chain->RunFrame(cmd, s->GetImage(), s->GetView(), VK_FORMAT_R8G8B8A8_UNORM, static_cast<u32>(sTex->GetWidth()),
+			static_cast<u32>(sTex->GetHeight()), static_cast<u32>(dTex->GetWidth()), static_cast<u32>(dTex->GetHeight()), frame))
+	{
+		ps5px_log("picture: the look stopped: %s", t.chain->error.c_str());
+		t.chain_failed = t.chain_path;
+		ExecuteCommandBuffer(true, "look stopped");
+		t.chain.reset();
+		t.chain_path.clear();
+		InvalidateCachedState();
+		return false;
+	}
+
+	// The last pass's picture (the size of the place) into dTex.
+	const PS5SlangRunner::Image& last = t.chain->Output();
+	d->TransitionToLayout(GSTextureVK::Layout::CopyDst);
+	d->SetUseFenceCounter(GetCurrentFenceCounter());
+	PS5SlangRunner::Barrier(cmd, last.image, 0, 1, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+		VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT | VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT,
+		VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT);
+	VkImageBlit blit{};
+	blit.srcSubresource = blit.dstSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1};
+	blit.srcOffsets[1] = {static_cast<s32>(last.width), static_cast<s32>(last.height), 1};
+	blit.dstOffsets[1] = {dTex->GetWidth(), dTex->GetHeight(), 1};
+	vkCmdBlitImage(cmd, last.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, d->GetImage(), VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &blit,
+		VK_FILTER_LINEAR);
+	d->PS5NoteWrite();
+	PS5SlangRunner::Barrier(cmd, last.image, 0, 1, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL,
+		VK_PIPELINE_STAGE_TRANSFER_BIT, 0, VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT);
+	InvalidateCachedState();
+	return true;
+}
+
+// ------------------------------------------------------------- the pipelines a game needs
+//
+// PCSX2 makes a draw's pipeline the first time a draw needs it, and the draw waits for it: on a
+// first visit to a scene, a run of short stops. Here what a game needed is kept by its serial
+// (cache/pipelines/<serial>.bin: a header naming the PCSX2 build, then the 32-byte selectors), and
+// at its next start the list is made again ahead of need, a few milliseconds' worth each frame, so
+// that the stops are gone by the time the scenes come (with the driver's pipeline cache most are
+// quick to make). A list is kept with what a selector means: the hardware renderer's shader
+// (tfx.glsl) and the selector's size. Since v1.4.0 it is not the build of PCSX2: a new build whose
+// shader and selectors are the same keeps the lists (until then each new PCSX2 dropped them all).
+// A list of another shader is not used.
+
+static std::string PipelineListPath(const std::string& serial)
+{
+	return Path::Combine(Path::Combine(EmuFolders::Cache, "pipelines"), serial + ".bin");
+}
+
+static constexpr char PIPELINE_LIST_MAGIC[8] = {'C', 'R', 'U', 'X', 'P', 'L', '0', '1'};
+
+// What a list's selectors mean: "tfx<hash of tfx.glsl>-sel<the selector's size>".
+static std::string PipelineListKey(const std::string& tfx_source)
+{
+	u64 hash = 14695981039346656037ull;
+	for (const unsigned char c : tfx_source)
+		hash = (hash ^ c) * 1099511628211ull;
+	return fmt::format("tfx{:016x}-sel{}", hash, sizeof(GSDeviceVK::PipelineSelector));
+}
+
+void GSDeviceVK::PipelinesForGame(const std::string& serial)
+{
+	// The game that ends: its list, with what it had before, written.
+	if (!m_ps5_pipelines_game.empty() && !m_ps5_new_pipelines.empty())
+	{
+		std::vector<PipelineSelector> all;
+		const std::string path = PipelineListPath(m_ps5_pipelines_game);
+		const std::string rev = PipelineListKey(m_tfx_source);
+		if (std::optional<std::vector<u8>> old = FileSystem::ReadBinaryFile(path.c_str());
+			old.has_value() && old->size() >= sizeof(PIPELINE_LIST_MAGIC) + 64 && std::memcmp(old->data(), PIPELINE_LIST_MAGIC, 8) == 0 &&
+			std::strncmp(reinterpret_cast<const char*>(old->data() + 8), rev.c_str(), 63) == 0)
+		{
+			const size_t count = (old->size() - 72) / sizeof(PipelineSelector);
+			all.resize(count);
+			std::memcpy(all.data(), old->data() + 72, count * sizeof(PipelineSelector));
+		}
+		for (const PipelineSelector& p : m_ps5_new_pipelines)
+		{
+			if (std::find(all.begin(), all.end(), p) == all.end())
+				all.push_back(p);
+		}
+		std::vector<u8> data(72 + all.size() * sizeof(PipelineSelector));
+		std::memcpy(data.data(), PIPELINE_LIST_MAGIC, 8);
+		std::strncpy(reinterpret_cast<char*>(data.data() + 8), rev.c_str(), 63);
+		std::memcpy(data.data() + 72, all.data(), all.size() * sizeof(PipelineSelector));
+		FileSystem::CreateDirectoryPath(std::string(Path::GetDirectory(path)).c_str(), false);
+		if (FileSystem::WriteBinaryFile(path.c_str(), data.data(), data.size()))
+			ps5px_log("pipelines: %zu kept for %s (%zu new this time)", all.size(), m_ps5_pipelines_game.c_str(), m_ps5_new_pipelines.size());
+	}
+	m_ps5_new_pipelines.clear();
+	m_ps5_warm_queue.clear();
+	m_ps5_pipelines_game = serial;
+	if (serial.empty())
+		return;
+
+	// The new game's list, to be made ahead.
+	const std::string path = PipelineListPath(serial);
+	std::optional<std::vector<u8>> list = FileSystem::ReadBinaryFile(path.c_str());
+	if (!list.has_value() || list->size() < 72 || std::memcmp(list->data(), PIPELINE_LIST_MAGIC, 8) != 0)
+		return;
+	if (std::strncmp(reinterpret_cast<const char*>(list->data() + 8), PipelineListKey(m_tfx_source).c_str(), 63) != 0)
+	{
+		ps5px_log("pipelines: the list of %s is of another renderer shader: not used", serial.c_str());
+		return;
+	}
+	const size_t count = (list->size() - 72) / sizeof(PipelineSelector);
+	m_ps5_warm_queue.resize(count);
+	std::memcpy(m_ps5_warm_queue.data(), list->data() + 72, count * sizeof(PipelineSelector));
+	ps5px_log("pipelines: %zu of %s are made ahead", count, serial.c_str());
+}
+
+// ---- pipelines: quickly first, optimised behind
+//
+// A pipeline a draw needs that is not there makes the draw wait for the driver to compile it. The
+// driver compiles one with VK_PIPELINE_CREATE_DISABLE_OPTIMIZATION_BIT much quicker (fewer of
+// its optimisation passes), at some cost in the GPU's time while that pipeline is in use; so the
+// draw gets that one, and a thread of its own builds the optimised pipeline from the same shaders
+// and render pass, which the next frame swaps in. ProsperoEden measured draws waiting 32% less
+// for pipelines from a cold cache this way. [PS5] FastPipelines = false builds them optimised
+// at once, as PCSX2 does. Needs proper testing.
+
+struct GSDeviceVK::PS5Optimiser
+{
+	struct Job
+	{
+		PipelineSelector p;
+		VkShaderModule vs, fs;
+		VkRenderPass rp;
+	};
+
+	std::mutex mutex;
+	std::condition_variable wake;
+	std::deque<Job> jobs;
+	std::vector<std::pair<PipelineSelector, VkPipeline>> done;
+	bool stop = false;
+	std::thread thread;
+
+	// Counted for the log (under mutex).
+	u32 fast = 0, optimised = 0, failed = 0;
+	double fast_ms = 0, optimised_ms = 0;
+};
+
+VkPipeline GSDeviceVK::PS5CreateTFXPipelineFast(const PipelineSelector& p)
+{
+	static const bool enabled = Host::GetBaseBoolSettingValue("PS5", "FastPipelines", true);
+	if (!enabled)
+		return CreateTFXPipeline(p);
+
+	VkShaderModule vs, fs;
+	VkRenderPass rp;
+	if (!ResolveTFXPipelineParts(p, &vs, &fs, &rp))
+		return VK_NULL_HANDLE;
+	Common::Timer timer;
+	const VkPipeline pipeline = BuildTFXPipeline(p, vs, fs, rp, VK_PIPELINE_CREATE_DISABLE_OPTIMIZATION_BIT);
+	const double ms = timer.GetTimeMilliseconds();
+	if (pipeline == VK_NULL_HANDLE)
+		return CreateTFXPipeline(p);
+
+	if (!m_ps5_optimiser)
+	{
+		m_ps5_optimiser = new PS5Optimiser();
+		PS5Optimiser* const o = m_ps5_optimiser;
+		o->thread = std::thread([this, o] {
+			Threading::SetNameOfCurrentThread("Pipeline optimiser");
+			std::unique_lock lock(o->mutex);
+			for (;;)
+			{
+				o->wake.wait(lock, [o] { return o->stop || !o->jobs.empty(); });
+				if (o->stop)
+					return;
+				const PS5Optimiser::Job job = o->jobs.front();
+				o->jobs.pop_front();
+				lock.unlock();
+				Common::Timer built;
+				const VkPipeline optimised = BuildTFXPipeline(job.p, job.vs, job.fs, job.rp, 0);
+				const double took = built.GetTimeMilliseconds();
+				lock.lock();
+				if (optimised == VK_NULL_HANDLE)
+				{
+					o->failed++;
+					continue;
+				}
+				o->optimised++;
+				o->optimised_ms += took;
+				o->done.emplace_back(job.p, optimised);
+			}
+		});
+		ps5px_log("pipelines: built quickly first, optimised on a thread of their own ([PS5] FastPipelines)");
+	}
+	{
+		const std::lock_guard lock(m_ps5_optimiser->mutex);
+		m_ps5_optimiser->fast++;
+		m_ps5_optimiser->fast_ms += ms;
+		m_ps5_optimiser->jobs.push_back({p, vs, fs, rp});
+	}
+	m_ps5_optimiser->wake.notify_one();
+	return pipeline;
+}
+
+void GSDeviceVK::PS5SwapOptimised()
+{
+	PS5Optimiser* const o = m_ps5_optimiser;
+	if (!o)
+		return;
+	std::vector<std::pair<PipelineSelector, VkPipeline>> done;
+	u32 fast, optimised, failed;
+	double fast_ms, optimised_ms;
+	{
+		const std::lock_guard lock(o->mutex);
+		if (o->done.empty())
+			return;
+		done.swap(o->done);
+		fast = o->fast;
+		optimised = o->optimised;
+		failed = o->failed;
+		fast_ms = o->fast_ms;
+		optimised_ms = o->optimised_ms;
+	}
+	const u32 before = optimised - static_cast<u32>(done.size());
+	for (const auto& [p, pipeline] : done)
+	{
+		const auto it = m_tfx_pipelines.find(p);
+		if (it == m_tfx_pipelines.end() || it->second == VK_NULL_HANDLE)
+		{
+			vkDestroyPipeline(m_device, pipeline, nullptr);
+			continue;
+		}
+		// The quick one may be in a command buffer the GPU has not finished: it goes with this
+		// frame's other leftovers, once the GPU is past it.
+		const VkPipeline quick = it->second;
+		it->second = pipeline;
+		m_frame_resources[m_current_frame].cleanup_resources.push_back([this, quick]() { vkDestroyPipeline(m_device, quick, nullptr); });
+	}
+	// (A line now and then: after the first 16, then every 256.)
+	if ((before < 16 && optimised >= 16) || (before / 256 != optimised / 256))
+	{
+		ps5px_log("pipelines: %u built quickly (%.1f ms each on average), %u optimised behind them (%.1f ms each)%s", fast,
+			fast ? fast_ms / fast : 0.0, optimised, optimised ? optimised_ms / optimised : 0.0,
+			failed ? fmt::format(", {} could not be optimised (the quick ones stay)", failed).c_str() : "");
+	}
+}
+
+void GSDeviceVK::PS5StopOptimiser()
+{
+	PS5Optimiser* const o = m_ps5_optimiser;
+	if (!o)
+		return;
+	{
+		const std::lock_guard lock(o->mutex);
+		o->stop = true;
+		o->jobs.clear();
+	}
+	o->wake.notify_all();
+	if (o->thread.joinable())
+		o->thread.join();
+	// (The GPU is idle here: Destroy waited for it.)
+	for (const auto& entry : o->done)
+		vkDestroyPipeline(m_device, entry.second, nullptr);
+	ps5px_log("pipelines: %u built quickly (%.1f ms each on average), %u optimised behind them (%.1f ms each)", o->fast,
+		o->fast ? o->fast_ms / o->fast : 0.0, o->optimised, o->optimised ? o->optimised_ms / o->optimised : 0.0);
+	delete o;
+	m_ps5_optimiser = nullptr;
+}
+
+void GSDeviceVK::PipelinesTick()
+{
+	PS5SwapOptimised();
+	if (m_ps5_warm_queue.empty())
+		return;
+	// About 3 ms a frame: the first frames of a game are a little slower, its scenes later not.
+	Common::Timer budget;
+	while (!m_ps5_warm_queue.empty() && budget.GetTimeMilliseconds() < 3.0)
+	{
+		const PipelineSelector p = m_ps5_warm_queue.back();
+		m_ps5_warm_queue.pop_back();
+		if (m_tfx_pipelines.find(p) == m_tfx_pipelines.end())
+		{
+			const VkPipeline pipeline = CreateTFXPipeline(p);
+			m_tfx_pipelines.emplace(p, pipeline);
+		}
+	}
+	if (m_ps5_warm_queue.empty())
+		ps5px_log("pipelines: the game's list is ready");
+}
+
+// ------------------------------------------------------------------------------------------------
+// Crux2: the GPU's time by the kind of work, for the boot log's test windows.
+//
+// While GPU timing is on (the performance overlay's GPU figure, a test run), each render pass of
+// the draw command buffer gets a timestamp as it begins and one as it ends, both at the end of the
+// pipe: the first says when the work before the pass was done, the second when the pass was. A
+// pass's kind is the heaviest kind of draw recorded in it: the rasterizer ordered view, then draws
+// with barriers, then plain draws; a pass with no game draw is a conversion, a copy or a clear,
+// and the present pass is its own. What lies between passes (uploads, copies, the compute
+// passes: FSR, frame generation, the look) is the command buffer's whole time less the passes'.
+// The overlap of one pass's end with the next's start is not separated: the figures are where the
+// time goes, to a few percent, not a trace.
+
+struct GSDeviceVK::PS5Sections
+{
+	static constexpr u32 MAX = 512; // passes timed in one command buffer; more are counted, not timed
+	enum Kind : u8
+	{
+		Conversion = 0,
+		Draw = 1,
+		Barrier = 2,
+		Ordered = 3,
+		Present = 4,
+		KINDS = 5
+	};
+
+	VkQueryPool pool = VK_NULL_HANDLE;
+	struct Buffer
+	{
+		bool on = false; // timing was on as the buffer began
+		bool open = false;
+		u32 count = 0;
+		u32 untimed = 0;
+		u8 kind[MAX] = {};
+	};
+	std::array<Buffer, NUM_COMMAND_BUFFERS> buffers;
+
+	// The window being summed (GS thread).
+	double ms[KINDS] = {};
+	u64 passes[KINDS] = {};
+	double total_ms = 0;
+	u64 buffers_read = 0;
+	u64 untimed = 0;
+	u32 frames = 0;
+
+	// The same sums for the overlay, kept apart so the test log's window above is not reset by it;
+	// latched into `shown` every half second or so of frames (GS thread).
+	double osd_ms[KINDS] = {};
+	u64 osd_passes[KINDS] = {};
+	double osd_total_ms = 0;
+	u64 osd_buffers_read = 0;
+	u32 osd_frames = 0;
+	GSDevice::PS5GpuSections shown;
+
+	// The timestamps of one command buffer, read back (here, not on the stack: MAX * 2 * 8 bytes).
+	std::array<u64, MAX * 2> times = {};
+
+	// Surface compression found for render targets, said once per size and kind.
+	std::vector<u64> said;
+	PFN_vkGetImageSubresourceLayout2EXT get_layout2 = nullptr;
+};
+
+void GSDeviceVK::PS5SectionsCreate()
+{
+	if (m_ps5_sections)
+		return;
+	auto* s = new PS5Sections();
+	VkQueryPoolCreateInfo info = {VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO};
+	info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+	info.queryCount = NUM_COMMAND_BUFFERS * PS5Sections::MAX * 2;
+	if (vkCreateQueryPool(m_device, &info, nullptr, &s->pool) != VK_SUCCESS)
+	{
+		ps5px_log("graphics: the GPU's time by kind of work cannot be measured (no query pool)");
+		s->pool = VK_NULL_HANDLE;
+	}
+	if (m_optional_extensions.vk_ext_image_compression_control)
+		s->get_layout2 = reinterpret_cast<PFN_vkGetImageSubresourceLayout2EXT>(
+			vkGetDeviceProcAddr(m_device, "vkGetImageSubresourceLayout2EXT"));
+	ps5px_log("graphics: GPU time by kind of work %s; surface compression of render targets %s",
+		s->pool ? "measured while GPU timing is on" : "not measured",
+		s->get_layout2 ? "asked of the driver" : "not asked (VK_EXT_image_compression_control missing)");
+	m_ps5_sections = s;
+}
+
+void GSDeviceVK::PS5SectionsDestroy()
+{
+	if (!m_ps5_sections)
+		return;
+	if (m_ps5_sections->pool != VK_NULL_HANDLE)
+		vkDestroyQueryPool(m_device, m_ps5_sections->pool, nullptr);
+	delete m_ps5_sections;
+	m_ps5_sections = nullptr;
+}
+
+void GSDeviceVK::PS5SectionsStart(u32 index)
+{
+	PS5Sections* s = m_ps5_sections;
+	if (!s || s->pool == VK_NULL_HANDLE)
+		return;
+	PS5Sections::Buffer& b = s->buffers[index];
+	b.on = m_gpu_timing_enabled;
+	b.open = false;
+	b.count = 0;
+	b.untimed = 0;
+	if (b.on)
+		vkCmdResetQueryPool(m_frame_resources[index].command_buffers[1], s->pool, index * PS5Sections::MAX * 2,
+			PS5Sections::MAX * 2);
+}
+
+void GSDeviceVK::PS5SectionBegin(bool present)
+{
+	PS5Sections* s = m_ps5_sections;
+	if (!s)
+		return;
+	PS5Sections::Buffer& b = s->buffers[m_current_frame];
+	if (!b.on)
+		return;
+	if (present)
+	{
+		s->frames++;
+		s->osd_frames++;
+	}
+	if (b.open)
+		return;
+	if (b.count >= PS5Sections::MAX)
+	{
+		b.untimed++;
+		return;
+	}
+	vkCmdWriteTimestamp(GetCurrentCommandBuffer(), VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, s->pool,
+		(m_current_frame * PS5Sections::MAX + b.count) * 2);
+	b.kind[b.count] = present ? PS5Sections::Present : PS5Sections::Conversion;
+	b.open = true;
+}
+
+void GSDeviceVK::PS5SectionMark(u8 kind)
+{
+	PS5Sections* s = m_ps5_sections;
+	if (!s)
+		return;
+	PS5Sections::Buffer& b = s->buffers[m_current_frame];
+	if (b.open && b.kind[b.count] != PS5Sections::Present && kind > b.kind[b.count])
+		b.kind[b.count] = kind;
+}
+
+void GSDeviceVK::PS5SectionEnd()
+{
+	PS5Sections* s = m_ps5_sections;
+	if (!s)
+		return;
+	PS5Sections::Buffer& b = s->buffers[m_current_frame];
+	if (!b.open)
+		return;
+	vkCmdWriteTimestamp(GetCurrentCommandBuffer(), VK_PIPELINE_STAGE_ALL_COMMANDS_BIT, s->pool,
+		(m_current_frame * PS5Sections::MAX + b.count) * 2 + 1);
+	b.count++;
+	b.open = false;
+}
+
+void GSDeviceVK::PS5SectionsRead(u32 index)
+{
+	PS5Sections* s = m_ps5_sections;
+	if (!s)
+		return;
+	PS5Sections::Buffer& b = s->buffers[index];
+	if (!b.on)
+		return;
+	b.on = false;
+	const double period = static_cast<double>(m_device_properties.limits.timestampPeriod) / 1e6; // ms a tick
+	FrameResources& resources = m_frame_resources[index];
+	if (resources.timestamp_query_state == QueryState::Ready)
+	{
+		std::array<u64, 2> whole = {};
+		if (vkGetQueryPoolResults(m_device, m_timestamp_query_pool, index * 2, 2, sizeof(whole), whole.data(), sizeof(u64),
+				VK_QUERY_RESULT_64_BIT) == VK_SUCCESS &&
+			whole[0] != 0 && whole[1] > whole[0])
+		{
+			s->total_ms += static_cast<double>(whole[1] - whole[0]) * period;
+			s->buffers_read++;
+			s->osd_total_ms += static_cast<double>(whole[1] - whole[0]) * period;
+			s->osd_buffers_read++;
+		}
+	}
+	s->untimed += b.untimed;
+	if (b.count == 0)
+		return;
+	std::array<u64, PS5Sections::MAX * 2>& t = s->times;
+	if (vkGetQueryPoolResults(m_device, s->pool, index * PS5Sections::MAX * 2, b.count * 2, sizeof(u64) * b.count * 2, t.data(),
+			sizeof(u64), VK_QUERY_RESULT_64_BIT) != VK_SUCCESS)
+		return;
+	for (u32 i = 0; i < b.count; i++)
+	{
+		const u64 begin = t[i * 2], end = t[i * 2 + 1];
+		if (begin == 0 || end < begin)
+			continue;
+		const u8 kind = b.kind[i];
+		s->ms[kind] += static_cast<double>(end - begin) * period;
+		s->passes[kind]++;
+		s->osd_ms[kind] += static_cast<double>(end - begin) * period;
+		s->osd_passes[kind]++;
+	}
+}
+
+bool GSDeviceVK::PS5GetGpuSections(PS5GpuSections& out)
+{
+	PS5Sections* s = m_ps5_sections;
+	if (!s)
+		return false;
+	// Latch a new window once it holds about half a second of frames (the overlay refreshes ten
+	// times a second; a shorter window would jitter).
+	if (s->osd_frames >= 30 && s->osd_buffers_read > 0)
+	{
+		const double frames = static_cast<double>(s->osd_frames);
+		PS5GpuSections& w = s->shown;
+		double passes_ms = 0;
+		for (double v : s->osd_ms)
+			passes_ms += v;
+		w.valid = true;
+		w.total_ms = s->osd_total_ms / frames;
+		w.ordered_ms = s->osd_ms[PS5Sections::Ordered] / frames;
+		w.barrier_ms = s->osd_ms[PS5Sections::Barrier] / frames;
+		w.draw_ms = s->osd_ms[PS5Sections::Draw] / frames;
+		w.conversion_ms = s->osd_ms[PS5Sections::Conversion] / frames;
+		w.present_ms = s->osd_ms[PS5Sections::Present] / frames;
+		w.outside_ms = std::max(0.0, s->osd_total_ms - passes_ms) / frames;
+		u64 passes = 0;
+		for (u64 n : s->osd_passes)
+			passes += n;
+		w.passes = static_cast<double>(passes) / frames;
+		for (double& v : s->osd_ms)
+			v = 0;
+		for (u64& n : s->osd_passes)
+			n = 0;
+		s->osd_total_ms = 0;
+		s->osd_buffers_read = 0;
+		s->osd_frames = 0;
+	}
+	else if (s->osd_frames >= 30)
+	{
+		// Frames but no timed buffer (GPU timing off): nothing to show.
+		s->shown.valid = false;
+		s->osd_frames = 0;
+	}
+	out = s->shown;
+	return out.valid;
+}
+
+std::string GSDeviceVK::PS5TakeGpuWindow()
+{
+	PS5Sections* s = m_ps5_sections;
+	if (!s || s->buffers_read == 0 || s->frames == 0)
+		return {};
+	const double frames = static_cast<double>(s->frames);
+	double passes_ms = 0;
+	for (double v : s->ms)
+		passes_ms += v;
+	const double between = std::max(0.0, s->total_ms - passes_ms);
+	const auto part = [&](PS5Sections::Kind k) {
+		return fmt::format("{:.2f} ms in {:.0f}", s->ms[k] / frames, static_cast<double>(s->passes[k]) / frames);
+	};
+	std::string line = fmt::format(
+		"GPU {:.2f} ms a frame: ordered-view passes {}, passes with barriers {}, other draw passes {}, conversions and clears "
+		"{}, present {}; outside passes (uploads, copies, FSR and other compute) {:.2f} ms",
+		s->total_ms / frames, part(PS5Sections::Ordered), part(PS5Sections::Barrier), part(PS5Sections::Draw),
+		part(PS5Sections::Conversion), part(PS5Sections::Present), between / frames);
+	if (s->untimed)
+		line += fmt::format(" ({} passes past {} in a command buffer not timed)", s->untimed, PS5Sections::MAX);
+	for (double& v : s->ms)
+		v = 0;
+	for (u64& n : s->passes)
+		n = 0;
+	s->total_ms = 0;
+	s->buffers_read = 0;
+	s->untimed = 0;
+	s->frames = 0;
+	return line;
+}
+
+void GSDeviceVK::PS5NoteCompression(GSTexture* tex)
+{
+	PS5Sections* s = m_ps5_sections;
+	if (!s || !s->get_layout2 || !tex->IsRenderTargetOrDepthStencil() || tex->GetWidth() < 640)
+		return;
+	const bool depth = GSTexture::IsDepthStencil(tex->GetUsage());
+	const bool storage = GSTexture::IsShaderWrite(tex->GetUsage());
+	const u64 key = (static_cast<u64>(tex->GetWidth()) << 32) | (static_cast<u64>(tex->GetHeight()) << 8) |
+					(static_cast<u64>(tex->GetFormat()) << 2) | (depth ? 2u : 0u) | (storage ? 1u : 0u);
+	if (std::find(s->said.begin(), s->said.end(), key) != s->said.end() || s->said.size() >= 24)
+		return;
+	s->said.push_back(key);
+	GSTextureVK* vtex = static_cast<GSTextureVK*>(tex);
+	VkImageSubresource2EXT sub = {VK_STRUCTURE_TYPE_IMAGE_SUBRESOURCE_2_EXT};
+	sub.imageSubresource.aspectMask = depth ? VK_IMAGE_ASPECT_DEPTH_BIT : VK_IMAGE_ASPECT_COLOR_BIT;
+	VkImageCompressionPropertiesEXT compression = {VK_STRUCTURE_TYPE_IMAGE_COMPRESSION_PROPERTIES_EXT};
+	VkSubresourceLayout2EXT layout = {VK_STRUCTURE_TYPE_SUBRESOURCE_LAYOUT_2_EXT};
+	layout.pNext = &compression;
+	s->get_layout2(m_device, vtex->GetImage(), &sub, &layout);
+	const bool compressed = (compression.imageCompressionFlags & VK_IMAGE_COMPRESSION_DISABLED_EXT) == 0;
+	ps5px_log("graphics: %ux%u %s%s: %s", tex->GetWidth(), tex->GetHeight(),
+		depth ? "depth target" : "render target", storage ? " (also written by shaders: the ordered view)" : "",
+		compressed ? (depth ? "compressed (HTILE)" : "compressed (DCC)") : "not compressed");
+}
