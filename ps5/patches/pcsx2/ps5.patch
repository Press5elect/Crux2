+VkSurfaceKHR VKSwapChain::CreateDisplaySurface(VkInstance instance, VkPhysicalDevice physical_device, WindowInfo* wi)
+{
+	// VK_KHR_display: the first display's fastest mode, on the plane that can show it. (On the PS5
+	// there is one of each: 3840x2160 through the console's VideoOut.)
+	if (!vkGetPhysicalDeviceDisplayPropertiesKHR || !vkGetPhysicalDeviceDisplayPlanePropertiesKHR ||
+		!vkGetDisplayModePropertiesKHR || !vkCreateDisplayPlaneSurfaceKHR)
+	{
+		Console.Error("VK: The driver does not implement VK_KHR_display.");
+		return VK_NULL_HANDLE;
+	}
+
+	u32 display_count = 0;
+	VkResult res = vkGetPhysicalDeviceDisplayPropertiesKHR(physical_device, &display_count, nullptr);
+	if (res != VK_SUCCESS || display_count == 0)
+	{
+		LOG_VULKAN_ERROR(res, "vkGetPhysicalDeviceDisplayPropertiesKHR found no display: ");
+		return VK_NULL_HANDLE;
+	}
+	std::vector<VkDisplayPropertiesKHR> displays(display_count);
+	res = vkGetPhysicalDeviceDisplayPropertiesKHR(physical_device, &display_count, displays.data());
+	if ((res != VK_SUCCESS && res != VK_INCOMPLETE) || display_count == 0)
+	{
+		LOG_VULKAN_ERROR(res, "vkGetPhysicalDeviceDisplayPropertiesKHR failed: ");
+		return VK_NULL_HANDLE;
+	}
+	const VkDisplayKHR display = displays[0].display;
+
+	u32 mode_count = 0;
+	res = vkGetDisplayModePropertiesKHR(physical_device, display, &mode_count, nullptr);
+	if (res != VK_SUCCESS || mode_count == 0)
+	{
+		LOG_VULKAN_ERROR(res, "vkGetDisplayModePropertiesKHR found no mode: ");
+		return VK_NULL_HANDLE;
+	}
+	std::vector<VkDisplayModePropertiesKHR> modes(mode_count);
+	res = vkGetDisplayModePropertiesKHR(physical_device, display, &mode_count, modes.data());
+	if ((res != VK_SUCCESS && res != VK_INCOMPLETE) || mode_count == 0)
+	{
+		LOG_VULKAN_ERROR(res, "vkGetDisplayModePropertiesKHR failed: ");
+		return VK_NULL_HANDLE;
+	}
+	// Which of the display's modes. The driver offers a mode for each size the console's VideoOut
+	// takes pictures of (3840x2160, 2560x1440, 1920x1080: it scales them to the screen), each at
+	// 59.94 Hz, and at 119.88 Hz as well for a title that declares it. The height asked for in the
+	// settings ([PS5] OutputHeight, 2160 unless set) when the display has it, else the largest; of
+	// one size, the fastest. (A driver with one mode has that one.)
+	// The rate asked for too ([PS5] OutputRefresh, 60 unless set to 120): a mode faster than that
+	// is passed over while a slower one is there. (The title declares 119.88 Hz in its package
+	// since v0.8.0; the driver's window system falls back to 59.94 by itself where the television
+	// does not follow. The driver reads that declaration from the file PS5_VIDEOOUT_PARAM_JSON
+	// names, which ps5_host.cpp sets: outside its sandbox the title does not see /app0, and v0.8.0,
+	// which did not set it, was offered 59.94 Hz only.)
+	const u32 wanted_height = static_cast<u32>(std::max(Host::GetBaseIntSettingValue("PS5", "OutputHeight", 2160), 0));
+	const u32 fastest = (Host::GetBaseIntSettingValue("PS5", "OutputRefresh", 60) <= 60) ? 61000u : 0xffffffffu; // millihertz
+	const auto better = [wanted_height, fastest](const VkDisplayModePropertiesKHR& a, const VkDisplayModePropertiesKHR& b) {
+		const VkExtent2D ea = a.parameters.visibleRegion, eb = b.parameters.visibleRegion;
+		const bool fa = (a.parameters.refreshRate <= fastest), fb = (b.parameters.refreshRate <= fastest);
+		if (fa != fb)
+			return fa;
+		const bool wa = (ea.height == wanted_height), wb = (eb.height == wanted_height);
+		if (wa != wb)
+			return wa;
+		const u64 area_a = static_cast<u64>(ea.width) * ea.height, area_b = static_cast<u64>(eb.width) * eb.height;
+		if (area_a != area_b)
+			return area_a > area_b;
+		return a.parameters.refreshRate > b.parameters.refreshRate;
+	};
+	const VkDisplayModePropertiesKHR* mode = &modes[0];
+	for (u32 i = 1; i < mode_count; i++)
+	{
+		if (better(modes[i], *mode))
+			mode = &modes[i];
+	}
+	for (u32 i = 0; i < mode_count; i++)
+	{
+		Console.WriteLn("VK: Display mode %u: %ux%u at %.2f Hz%s", i, modes[i].parameters.visibleRegion.width,
+			modes[i].parameters.visibleRegion.height, static_cast<float>(modes[i].parameters.refreshRate) / 1000.0f,
+			(&modes[i] == mode) ? " (taken)" : "");
+	}
+
+	u32 plane_count = 0;
+	res = vkGetPhysicalDeviceDisplayPlanePropertiesKHR(physical_device, &plane_count, nullptr);
+	if (res != VK_SUCCESS || plane_count == 0)
+	{
+		LOG_VULKAN_ERROR(res, "vkGetPhysicalDeviceDisplayPlanePropertiesKHR found no plane: ");
+		return VK_NULL_HANDLE;
+	}
+	std::vector<VkDisplayPlanePropertiesKHR> planes(plane_count);
+	res = vkGetPhysicalDeviceDisplayPlanePropertiesKHR(physical_device, &plane_count, planes.data());
+	if ((res != VK_SUCCESS && res != VK_INCOMPLETE) || plane_count == 0)
+	{
+		LOG_VULKAN_ERROR(res, "vkGetPhysicalDeviceDisplayPlanePropertiesKHR failed: ");
+		return VK_NULL_HANDLE;
+	}
+	u32 plane_index = plane_count;
+	for (u32 i = 0; i < plane_count; i++)
+	{
+		if (planes[i].currentDisplay == VK_NULL_HANDLE || planes[i].currentDisplay == display)
+		{
+			plane_index = i;
+			break;
+		}
+	}
+	if (plane_index == plane_count)
+	{
+		Console.Error("VK: No display plane can show the display.");
+		return VK_NULL_HANDLE;
+	}
+
+	const VkDisplaySurfaceCreateInfoKHR surface_create_info = {
+		.sType = VK_STRUCTURE_TYPE_DISPLAY_SURFACE_CREATE_INFO_KHR,
+		.pNext = nullptr,
+		.flags = 0,
+		.displayMode = mode->displayMode,
+		.planeIndex = plane_index,
+		.planeStackIndex = planes[plane_index].currentStackIndex,
+		.transform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR,
+		.globalAlpha = 1.0f,
+		.alphaMode = VK_DISPLAY_PLANE_ALPHA_OPAQUE_BIT_KHR,
+		.imageExtent = mode->parameters.visibleRegion,
+	};
+	VkSurfaceKHR surface = VK_NULL_HANDLE;
+	res = vkCreateDisplayPlaneSurfaceKHR(instance, &surface_create_info, nullptr, &surface);
+	if (res != VK_SUCCESS)
+	{
+		LOG_VULKAN_ERROR(res, "vkCreateDisplayPlaneSurfaceKHR failed: ");
+		return VK_NULL_HANDLE;
+	}
+
+	// The mode decides the size and the refresh rate (millihertz), whatever the host guessed.
+	wi->surface_width = mode->parameters.visibleRegion.width;
+	wi->surface_height = mode->parameters.visibleRegion.height;
+	wi->surface_refresh_rate = static_cast<float>(mode->parameters.refreshRate) / 1000.0f;
+	Console.WriteLn("VK: Display surface: %ux%u at %.2f Hz", wi->surface_width, wi->surface_height,
+		wi->surface_refresh_rate);
+	// In the boot log too: whether 120 Hz was offered and taken is the first thing asked of a run.
+	{
+		u32 fast_modes = 0;
+		for (u32 i = 0; i < mode_count; i++)
+			fast_modes += (modes[i].parameters.refreshRate > 61000u) ? 1 : 0;
+		ps5px_log("display: %ux%u at %.2f Hz (the console offered %u mode(s), %u of them above 60 Hz)", wi->surface_width,
+			wi->surface_height, wi->surface_refresh_rate, mode_count, fast_modes);
+		// Variable refresh ([PS5] VariableRefresh): the driver answers in the variable it was asked by, "on" when the
+		// output left its fixed rate and "refused" when it did not (PS5_Mesa patch 0016).
+		if (const char* vrr = std::getenv("PS5_VIDEOOUT_VRR"); vrr != nullptr)
+			ps5px_log("display: variable refresh %s", (std::strcmp(vrr, "on") == 0) ? "on" :
+													  (std::strcmp(vrr, "refused") == 0) ? "refused by the output" :
+																						   "asked for, not tried (no 120 Hz output)");
+	}
+	return surface;
+}
