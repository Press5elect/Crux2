+{
+	VkShaderModule vs, fs;
+	VkRenderPass rp;
+	if (!ResolveTFXPipelineParts(p, &vs, &fs, &rp))
+		return VK_NULL_HANDLE;
+	return BuildTFXPipeline(p, vs, fs, rp, 0);
