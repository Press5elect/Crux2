+	barrier.oldLayout = GetFeedbackLoopLayout();
+	barrier.newLayout = GetFeedbackLoopLayout();
+	barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+	barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+	barrier.image = tex->GetImage();
+	barrier.subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0u, VK_REMAINING_MIP_LEVELS, 0u, 1u};
+
+	VkDependencyInfo dependency = {VK_STRUCTURE_TYPE_DEPENDENCY_INFO};
+	dependency.imageMemoryBarrierCount = 1;
+	dependency.pImageMemoryBarriers = &barrier;
+	vkCmdPipelineBarrier2KHR(GetCurrentCommandBuffer(), &dependency);
+
+	g_perfmon.Put(GSPerfMon::Barriers, 1);
+	tex->PS5FeedbackClear(GSTextureVK::PS5_FB_WRITTEN | GSTextureVK::PS5_FB_SAMPLED);
+}
+
+bool GSDeviceVK::PS5SampleInFeedbackLayout(GSTextureVK* tex, bool may_end_render_pass, bool* descriptor_stale)
+{
+	*descriptor_stale = false;
+	if (!PS5InFeedbackLayout(tex))
+		return false;
+
+	if (tex->PS5FeedbackHas(GSTextureVK::PS5_FB_WRITTEN))
+	{
+		// Drawn to since the last barrier: the read must wait for those writes. The upstream path would
+		// end the pass here too (for its transition to the shader-read layout).
+		if (InRenderPass())
+		{
+			if (!may_end_render_pass)
+				return false;
+			GL_INS("VK: End render pass to sample a target held in the feedback loop layout.");
+			EndRenderPass();
+		}
+		PS5FeedbackSelfBarrier(tex);
+	}
+
+	if (tex->PS5FeedbackHas(GSTextureVK::PS5_FB_DESC_STALE))
+	{
+		*descriptor_stale = true;
+		tex->PS5FeedbackClear(GSTextureVK::PS5_FB_DESC_STALE);
+	}
+
+	tex->PS5FeedbackSet(GSTextureVK::PS5_FB_SAMPLED);
+	return true;
+}
+
+void GSDeviceVK::PS5NoteDraw(u8 writes)
+{
+	// The barrier bookkeeping (PS5FeedbackBarrierIfOwed): an attachment this may write is owed a barrier again.
+	if (writes & 1)
+		m_ps5_fb_clean_rt = nullptr;
+	if (writes & 2)
+		m_ps5_fb_clean_ds = nullptr;
+
+	// The write generation of everything a draw can write (GSTexture::PS5WriteGen): the bound attachments and
+	// the ordered views, whatever the masks say (counting a write that did not happen only costs a reuse).
+	if (m_current_render_target)
+		m_current_render_target->PS5NoteWrite();
+	if (m_current_depth_target)
+		m_current_depth_target->PS5NoteWrite();
+	if (m_tfx_textures[TFX_TEXTURE_RT_ROV])
+		m_tfx_textures[TFX_TEXTURE_RT_ROV]->PS5NoteWrite();
+	if (m_tfx_textures[TFX_TEXTURE_DEPTH_ROV])
+		m_tfx_textures[TFX_TEXTURE_DEPTH_ROV]->PS5NoteWrite();
+}
+
+void GSDeviceVK::PS5FeedbackBarrierIfOwed(GSTextureVK* rt, GSTextureVK* ds)
+{
+	// Exact: the barrier's first scope is the colour attachment output (depth: fragment tests) stage with the
+	// attachment write access, its second the fragment shader's reads. Its only effect is that attachment writes
+	// recorded before it in this pass are seen by shader reads after it. With no write to the attachment since the
+	// last such barrier in this pass, every earlier write is already covered by that one, and the reads after it
+	// were already ordered after them; this barrier would add nothing. (It never ordered earlier shader reads
+	// before later writes either: shader reads are not in its first scope.) A new render pass starts owing one.
+	if (!m_ps5_skip_barriers || !InRenderPass())
+	{
+		const u32 n = (rt ? 1 : 0) + (ds ? 1 : 0);
+		if (n == 0)
+			return;
+		g_perfmon.Put(GSPerfMon::Barriers, n);
+		FeedbackBarrier(rt, ds, true);
+		if (InRenderPass())
+		{
+			if (rt)
+				m_ps5_fb_clean_rt = rt;
+			if (ds)
+				m_ps5_fb_clean_ds = ds;
+		}
+		return;
+	}
+
+	GSTextureVK* const need_rt = (rt && m_ps5_fb_clean_rt != rt) ? rt : nullptr;
+	GSTextureVK* const need_ds = (ds && m_ps5_fb_clean_ds != ds) ? ds : nullptr;
+	const u32 skipped = ((rt && !need_rt) ? 1 : 0) + ((ds && !need_ds) ? 1 : 0);
+	if (skipped)
+		g_perfmon.Put(GSPerfMon::BarriersSkipped, skipped);
+	if (!need_rt && !need_ds)
+		return;
+
+	g_perfmon.Put(GSPerfMon::Barriers, (need_rt ? 1 : 0) + (need_ds ? 1 : 0));
+	FeedbackBarrier(need_rt, need_ds, true);
+	if (need_rt)
+		m_ps5_fb_clean_rt = need_rt;
+	if (need_ds)
+		m_ps5_fb_clean_ds = need_ds;
+}
