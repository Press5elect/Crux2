+static void mVUemitLowerSoftUnaryCacheIndex(const xRegister32& index, const xRegister32& key)
+{
+	static_assert(mVUsoftLowerCacheSize == 4096);
+	xMUL(index, key, static_cast<s32>(2654435761u));
