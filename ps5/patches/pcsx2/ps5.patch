+	}
+	s_gs_mapped_repeats = 0;
+
+	if (s_gs_shm)
+		HostSys::DestroySharedMemory(s_gs_shm);
+	s_gs_shm = nullptr;
+}
+
+void* GSAllocateWrappedMemory(size_t size, size_t repeat)
+{
+	pxAssert(!s_gs_shm && !s_gs_area);
+
+	s_gs_shm = HostSys::CreateSharedMemory("GS.mem", size);
+	if (s_gs_shm)
+		s_gs_area = SharedMemoryMappingArea::Create(size * repeat);
+	if (!s_gs_area)
+	{
+		Console.Error("Failed to allocate %zu bytes of wrapped GS memory.", size);
+		GSFreeWrappedMemory(nullptr, size, repeat);
+		return nullptr;
+	}
+
+	u8* const base = s_gs_area->BasePointer();
+	for (size_t i = 0; i < repeat; i++)
+	{
+		if (!s_gs_area->Map(s_gs_shm, 0, base + size * i, size, PageAccess_ReadWrite()))
+		{
+			Console.Error("Failed to map repeat %zu of %zu bytes of GS memory.", i, size);
+			GSFreeWrappedMemory(nullptr, size, repeat);
+			return nullptr;
+		}
+		s_gs_mapped_repeats++;
+	}
+
+	return base;
+}
