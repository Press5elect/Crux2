+	// in a scene of 4,000 draws a frame). The next draw's indices and constants go where this one's
+	// end, and are about as large: those lines are asked for now, and arrive while the thread
+	// does the rest of this draw. A prefetch is a hint: it changes no data and cannot fault.
+	if (m_ps5_prefetch && final_num_bytes != 0)
+	{
+		const u32 ahead = std::min<u32>(std::min<u32>((final_num_bytes + 127) & ~63u, 1024), m_size - m_current_offset);
+		const u8* const next = m_host_pointer + m_current_offset;
+		for (u32 offset = 0; offset < ahead; offset += 64)
+			__builtin_prefetch(next + offset, 1, 3);
+	}
+#endif
