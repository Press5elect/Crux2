+// Whole 2048-byte sectors. 0, or the errno of the failure (-1: the media ended first).
+int IOCtlSrc::PS5ReadRaw(u32 sector, u32 count, u8* buffer) const
+{
+	if (m_device == -1)
+		return EBADF;
+
+	size_t left = static_cast<size_t>(count) * 2048;
+	off_t offset = static_cast<off_t>(sector) * 2048;
+	while (left != 0)
+	{
+		const ssize_t got = pread(m_device, buffer, left, offset);
+		if (got < 0 && errno == EINTR)
+			continue;
+		if (got < 0)
+			return errno;
+		if (got == 0)
+			return -1;
+		buffer += got;
+		left -= static_cast<size_t>(got);
+		offset += got;
+	}
+	return 0;
+}
