+		m_fg_video = video;
+		if (GSConfig.FrameGen != GSFrameGenMode::Disabled)
+			ps5px_log("picture: frame generation %s", video ? "pauses while the game plays a video" : "goes on after the video");
+	}
+	if (!wanted)
+	{
+		// (Switched off: the memory is given back. Otherwise it is kept for the next pictures.)
+		if (GSConfig.FrameGen == GSFrameGenMode::Disabled)
+			g_gs_device->FrameGenReset();
+		else
