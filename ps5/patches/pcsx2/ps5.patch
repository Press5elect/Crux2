+#ifdef __PROSPERO__
+// PS5: what the title writes is fetched and replaced over FTP, by another process, and by the
+// title itself as another user once it has left its sandbox. So a file it creates is 0666 and a
+// folder 0777, set explicitly: the mode given to open() and mkdir() is cut down by the umask.
+// (A path on a network share is not a file of the console's: chmod fails there, harmlessly.)
+static bool PS5OpensForWriting(const char* mode)
+{
+	return (std::strpbrk(mode, "wa+") != nullptr);
+}
+
+static void PS5MakeFilePublic(const char* filename)
+{
+	(void)chmod(filename, 0666);
