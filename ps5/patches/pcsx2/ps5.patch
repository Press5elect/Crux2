+			mVUemitUpperSoftStackAlloc(scalar_stack_size);
+			xMOV(scalarResultPtr(offsetof(VuSoftFmacJitResult, mac_flags)), 0);
+			xMOV(scalarResultPtr(offsetof(VuSoftFmacJitResult, status_flags)), 0);
