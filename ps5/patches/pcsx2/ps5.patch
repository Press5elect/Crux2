+
+// Crux2: for the log, after applyGSHardwareFixes (VMManager::ApplyGameFixes). Each fix of the
+// game's entry is in effect, not applied (Manual hardware renderer fixes is on: PCSX2 then leaves
+// the database's user-hack fixes out), or applied but not in effect (another setting decides,
+// e.g. an upscaling fix at native resolution, or a recommended level that was not taken).
+std::string GameDatabase::describeGSHardwareFixes(const GameDatabaseSchema::GameEntry& game, const Pcsx2Config::GSOptions& config)
+{
+	using namespace GameDatabaseSchema;
+	if (game.gsHWFixes.empty())
+		return {};
+
+	static constexpr const char* blending[] = {"minimum", "basic", "medium", "high", "full", "maximum"};
+	const auto blend = [](int level) { return blending[(level < 0) ? 0 : (level > 5) ? 5 : level]; };
+	const auto add = [](std::string& list, const std::string& item) {
+		if (!list.empty())
+			list += ", ";
+		list += item;
+	};
+
+	std::string applied, skipped, lost;
+	for (const auto& [id, value] : game.gsHWFixes)
+	{
+		bool in_effect;
+		std::string item;
+		switch (id)
+		{
+			case GSHWFixId::MinimumBlendingLevel:
+			case GSHWFixId::MaximumBlendingLevel:
+				item = fmt::format("{} {}", getHWFixName(id), blend(value));
+				in_effect = GameEntry::configMatchesHWFix(config, id, value);
+				break;
+			case GSHWFixId::RecommendedBlendingLevel:
+				item = fmt::format("{} {}", getHWFixName(id), blend(value));
+				in_effect = static_cast<int>(config.AccurateBlendingUnit) >= value;
+				break;
+			case GSHWFixId::RecommendedAccurateAlphaTest:
+				item = fmt::format("{} {}", getHWFixName(id), value);
+				in_effect = static_cast<int>(config.HWAccurateAlphaTest) >= value;
+				break;
+			case GSHWFixId::RecommendedHWAA1:
+				item = fmt::format("{} {}", getHWFixName(id), value);
+				in_effect = static_cast<int>(config.HWAA1) >= value;
+				break;
+			default:
+				item = fmt::format("{} {}", getHWFixName(id), value);
+				in_effect = GameEntry::configMatchesHWFix(config, id, value);
+				break;
+		}
+		if (in_effect)
+			add(applied, item);
+		else if (config.ManualUserHacks && isUserHackHWFix(id))
+			add(skipped, item);
+		else
+			add(lost, item);
+	}
+
+	std::string line = fmt::format("game fixes: from the game database, in effect: {}", applied.empty() ? "none" : applied.c_str());
+	if (!skipped.empty())
+		line += fmt::format("; not applied, as Manual hardware renderer fixes is on: {}", skipped);
+	if (!lost.empty())
+		line += fmt::format("; not in effect (other settings decide): {}", lost);
+	line += fmt::format(" (blending {}{})", blend(static_cast<int>(config.AccurateBlendingUnit)),
+		(config.Renderer == GSRendererType::SW) ? ", software renderer: these are for the hardware one" : "");
+	return line;
+}
+#endif
