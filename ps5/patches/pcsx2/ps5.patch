+void VMManager::ZipAutomaticOnThread(std::unique_ptr<ArchiveEntryList> elist, std::unique_ptr<SaveStateScreenshotData> screenshot,
+	std::string filename, int zstd_level, std::function<void(std::vector<u8> data, std::string error)> done)
