+void GameDatabase::forEachMemcardFilters(const std::function<void(const std::string& serial, const std::vector<std::string>& filters)>& each)
+{
+	GameDatabase::ensureLoaded();
+	for (const auto& [serial, entry] : s_game_db)
+	{
+		if (!entry.memcardFilters.empty())
+			each(serial, entry.memcardFilters);
+	}
