+void GSDeviceVK::PS5ReadSettings(bool at_create)
+{
+	// The device is made once when the title starts and kept while Big Picture runs (VMManager keeps the GS
+	// open between games), so these are read here when it is made and again at each game start, with that
+	// game's own settings layered in (GSGameChanged -> PS5ReadGameSettings).
+	const bool hold = Host::GetBoolSettingValue("EmuCore/GS", "PS5HoldFeedbackLayout", false);
+	const bool skip = Host::GetBoolSettingValue("EmuCore/GS", "PS5SkipRedundantBarriers", true);
+	const bool no_compression_asked = Host::GetBoolSettingValue("EmuCore/GS", "PS5RTNoCompression", false);
+	const bool no_compression = no_compression_asked && m_ps5_compression_control;
+	const bool rov_keep = Host::GetBoolSettingValue("EmuCore/GS", "PS5ROVKeepPass", true);
+
+	if (!at_create)
+	{
+		const bool hold_changed = (hold != m_ps5_hold_feedback);
+		if (hold_changed || skip != m_ps5_skip_barriers || no_compression != m_ps5_rt_no_compression ||
+			rov_keep != m_ps5_rov_keep_pass)
+		{
+			// A clean point: no pass open (the barrier bookkeeping starts again), and, when the held layout is
+			// switched, one barrier over everything recorded so far. Under one rule a held target's reads and
+			// writes were tracked by the PS5 flags (no transition), under the other by transitions; neither
+			// knows what the other left owed, and after this barrier nothing is owed.
+			EndRenderPass();
+			if (hold_changed)
+			{
+				VkMemoryBarrier2 mb = {VK_STRUCTURE_TYPE_MEMORY_BARRIER_2};
+				mb.srcStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+				mb.srcAccessMask = VK_ACCESS_2_MEMORY_WRITE_BIT;
+				mb.dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+				mb.dstAccessMask = VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT;
+				VkDependencyInfo dependency = {VK_STRUCTURE_TYPE_DEPENDENCY_INFO};
+				dependency.memoryBarrierCount = 1;
+				dependency.pMemoryBarriers = &mb;
+				vkCmdPipelineBarrier2KHR(GetCurrentCommandBuffer(), &dependency);
+			}
+			// Render targets made under the other compression rule are not reused from the pool: the game's
+			// targets (the texture cache was emptied when the last game closed) are all made under this one.
+			if (no_compression != m_ps5_rt_no_compression)
+				PurgePool();
+		}
+	}
+
+	m_ps5_hold_feedback = hold;
+	m_ps5_skip_barriers = skip;
+	m_ps5_rt_no_compression = no_compression;
+	m_ps5_rov_keep_pass = rov_keep;
+
+	const char* when = at_create ? "" : " (this game)";
+	ps5px_log("graphics%s: render targets a draw has read %s", when, m_ps5_hold_feedback ?
+		"stay in the feedback loop layout (no decompression each time; experimental)" : "leave the feedback loop layout as upstream does");
+	ps5px_log("graphics%s: feedback barriers on a target nothing wrote since the last one %s", when,
+		m_ps5_skip_barriers ? "left out" : "made anyway (PS5SkipRedundantBarriers off)");
+	ps5px_log("graphics%s: colour render targets %s", when, m_ps5_rt_no_compression ?
+		"made without surface compression (no DCC, never decompressed; experimental)" :
+		no_compression_asked ? "compressed as the driver chooses (PS5RTNoCompression asked for, but the device cannot "
+		"turn compression off: no imageCompressionControl)" : "compressed as the driver chooses");
+	ps5px_log("graphics%s: ordered view draws %s", when, m_ps5_rov_keep_pass ?
+		"keep their render pass when only an unused feedback flag differs" :
+		"end the render pass whenever the feedback flags differ, as upstream does (PS5ROVKeepPass off)");
+}
+
+void GSDeviceVK::PS5ReadGameSettings()
+{
+	PS5ReadSettings(false);
+}
+
+bool GSDeviceVK::PS5InFeedbackLayout(const GSTextureVK* tex) const
+{
+	// ([EmuCore/GS] PS5HoldFeedbackLayout, read when the device is made and at each game start: off, every
+	// render target leaves the feedback loop layout as upstream does.)
+	return tex && m_ps5_hold_feedback && UseFeedbackLoopLayout() && m_features.texture_barrier && !tex->IsDepthStencil() &&
+	       tex->GetLayout() == GSTextureVK::Layout::FeedbackLoop;
+}
