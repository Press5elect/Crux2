+extern "C" void ps5px_log(const char* format, ...);
+#endif
+
+// PS5: frame generation. Eight pipelines over resources/shaders/vulkan/framegen.glsl, made as
+// FSR's are: seven that write the small pictures the search works in (a format with room for a
+// move: sixteen bits a number), and one that writes the picture itself.
+void GSDeviceVK::CompileFrameGenPipelines()
+{
+	const std::optional<std::string> source = ReadShaderSource("shaders/vulkan/framegen.glsl");
+	if (!source.has_value())
+	{
+		Console.Warning("VK: Frame generation's shader is not in the resources: it is not available.");
+		return;
+	}
+
+	VkShaderModule vs = GetUtilityVertexShader(m_convert_source);
+	if (vs == VK_NULL_HANDLE)
+		return;
+	ScopedGuard vs_guard([this, &vs]() { vkDestroyShaderModule(m_device, vs, nullptr); });
+
+	Vulkan::GraphicsPipelineBuilder gpb;
+	SetPipelineProvokingVertex(m_features, gpb);
+	AddUtilityVertexAttributes(gpb);
+	gpb.SetPipelineLayout(m_utility_pipeline_layout);
+	gpb.SetDynamicViewportAndScissorState();
+	gpb.AddDynamicState(VK_DYNAMIC_STATE_BLEND_CONSTANTS);
+	gpb.AddDynamicState(VK_DYNAMIC_STATE_LINE_WIDTH);
+	gpb.SetNoCullRasterizationState();
+	gpb.SetNoBlendingState();
+	gpb.SetVertexShader(vs);
+
+	const VkRenderPass small =
+		GetRenderPass(LookupNativeFormat(GSTexture::Format::ColorHDR), VK_FORMAT_UNDEFINED, VK_ATTACHMENT_LOAD_OP_DONT_CARE);
+	const VkRenderPass picture = GetRenderPass(VK_FORMAT_R8G8B8A8_UNORM, VK_FORMAT_UNDEFINED, VK_ATTACHMENT_LOAD_OP_DONT_CARE);
+	bool ok = (small != VK_NULL_HANDLE && picture != VK_NULL_HANDLE);
+	for (u32 pass = 0; ok && pass < NUM_FRAMEGEN_PASSES; pass++)
+	{
+		std::stringstream source_with_header;
+		AddMacro(source_with_header, "FG_PASS", static_cast<int>(pass));
+		source_with_header << *source;
+
+		VkShaderModule mod = GetUtilityFragmentShader(source_with_header.str());
+		ScopedGuard mod_guard = [this, &mod]() {
+			if (mod != VK_NULL_HANDLE)
+				vkDestroyShaderModule(m_device, mod, nullptr);
+		};
+		if (mod != VK_NULL_HANDLE)
+		{
+			gpb.SetRenderPass((pass >= 7) ? picture : small, 0); // (7 and 8 write pictures)
+			gpb.SetFragmentShader(mod);
+			m_fg_pipelines[pass] = gpb.Create(m_device, g_vulkan_shader_cache->GetPipelineCache(true), false);
+		}
+		if (m_fg_pipelines[pass] == VK_NULL_HANDLE)
+		{
+			Console.Warning("VK: Frame generation's pass %u could not be made: it is not available.", pass);
+#ifdef __PROSPERO__
+			ps5px_log("picture: frame generation's pass %u could not be made by the graphics driver: it stays off", pass);
+#endif
+			ok = false;
+		}
+	}
+	if (!ok)
+	{
+		for (VkPipeline& it : m_fg_pipelines)
+		{
+			if (it != VK_NULL_HANDLE)
+				vkDestroyPipeline(m_device, it, nullptr);
+			it = VK_NULL_HANDLE;
+		}
+		return;
+	}
+	Console.WriteLn("VK: Frame generation is available.");
+#ifdef __PROSPERO__
+	ps5px_log("picture: frame generation's %u passes were made by the graphics driver", NUM_FRAMEGEN_PASSES);
+#endif
+}
