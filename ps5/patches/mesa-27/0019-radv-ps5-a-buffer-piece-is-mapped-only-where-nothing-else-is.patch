From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Mihawk <163614687+mihawk-99@users.noreply.github.com>
Date: Tue, 3 Nov 2026 16:57:23 -0500
Subject: [PATCH] radv/ps5: a buffer piece is mapped only where nothing else is

A device-memory buffer backed by several direct-memory ranges mapped each one at its place with a
fixed mapping, which replaces anything already mapped in that range: another allocation's range
there would then reach this buffer's memory, and nothing once this buffer is freed.

Each piece is now placed as a whole buffer is: at the address asked for, and only if the kernel puts
it there; otherwise the allocation fails as it would with no free range, and the range in use is
reported. In seven runs since, no range was found in use: GPU page faults seen after a buffer went in
pieces are not explained by this.

(cherry picked from commit 249fe49d2d8b49ee92b3d5b3ba4906faf5284af0)
---
 src/amd/vulkan/winsys/ps5/radv_ps5_platform.c | 22 ++++++++++++++++++-
 1 file changed, 21 insertions(+), 1 deletion(-)

diff --git a/src/amd/vulkan/winsys/ps5/radv_ps5_platform.c b/src/amd/vulkan/winsys/ps5/radv_ps5_platform.c
index 3a6db391a96..1cce4c4d388 100644
--- a/src/amd/vulkan/winsys/ps5/radv_ps5_platform.c
+++ b/src/amd/vulkan/winsys/ps5/radv_ps5_platform.c
@@ -551,6 +551,26 @@ radv_ps5_map_fixed(uint8_t *at, uint64_t bytes, int64_t physical)
  * the pool was free. */
 #define RADV_PS5_MAX_CHUNKS 256u
 
+/* A chunk goes at its place only if nothing is mapped there: a fixed mapping
+ * replaces whatever another allocation left in the range, whose own range
+ * then reaches this buffer's memory and, once this one is freed, nothing (the
+ * GPU faults on it). As radv_ps5_memory_alloc places a whole buffer. */
+static bool
+radv_ps5_map_free_at(uint8_t *at, uint64_t bytes, int64_t physical)
+{
+   void *address = at;
+   if (sceKernelMapDirectMemory(&address, bytes, RADV_PS5_PROTECTION, 0, physical, RADV_PS5_LARGE_BYTES) != 0)
+      return false;
+   if (address == at)
+      return true;
+   static uint32_t reported;
+   if (p_atomic_inc_return(&reported) <= 16)
+      fprintf(stderr, "radv/ps5: a buffer piece's range at %p is in use (placed at %p): not taken\n", (void *)at,
+              address);
+   sceKernelMunmap(address, bytes);
+   return false;
+}
+
 static void
 radv_ps5_chunks_release(uint8_t *base, struct radv_ps5_chunk *chunks, uint32_t count)
 {
@@ -595,7 +615,7 @@ radv_ps5_memory_alloc_chunked(uint64_t bytes, uint64_t alignment, struct radv_ps
          misses++;
          continue;
       }
-      if (!radv_ps5_map_fixed(base + offset, take, physical)) {
+      if (!radv_ps5_map_free_at(base + offset, take, physical)) {
          sceKernelReleaseDirectMemory(physical, take);
          break;
       }
