From 1dc89116d1c920462db45557a0e2473c696a8e30 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 16 Nov 2026 20:13:33 +0000
Subject: [PATCH] radv/ps5: new buffers zeroed with non-temporal stores on
 request

A new buffer is zeroed with memset and then radv_ps5_cpu_flush (MFENCE, one
CLFLUSHOPT a 64-byte line, MFENCE): two passes over the range, the second
alone 18.7% of a graphics thread's samples when a 41 MB render target was
created. With RADV_PS5_STREAM_ZERO=1 (read once; off by default, which is
the code as it was) radv_ps5_buffer_create writes the zeroes with AVX2
non-temporal stores (_mm256_stream_si256) and one SFENCE instead, through
radv_ps5_cpu_zero_streamed: one pass, no read for ownership, and the range
left as memset and the flush leave it, in memory and in no cache line. The
mapping is page-aligned (16 KiB pages) and its pages cover the size rounded
up to 32 bytes; an unaligned address or a build without AVX2 falls back to
memset and the flush, and a length not a multiple of 32 ends with them.
Every other caller of radv_ps5_cpu_flush is as it was. Each device logs
"radv/ps5: new buffers zeroed with non-temporal stores (RADV_PS5_STREAM_ZERO)"
when it is on.

Claude-Session: https://claude.ai/code/session_01EniyCuLSq8bzaeVVgyk9gK
---
 src/amd/vulkan/winsys/ps5/radv_ps5_bo.c       | 31 +++++++++++--
 src/amd/vulkan/winsys/ps5/radv_ps5_platform.c | 46 +++++++++++++++++++
 src/amd/vulkan/winsys/ps5/radv_ps5_platform.h |  7 +++
 src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c   |  7 +++
 src/amd/vulkan/winsys/ps5/radv_ps5_winsys.h   |  4 ++
 5 files changed, 92 insertions(+), 3 deletions(-)

diff --git a/src/amd/vulkan/winsys/ps5/radv_ps5_bo.c b/src/amd/vulkan/winsys/ps5/radv_ps5_bo.c
index 2aff5f859dc683003041300f6eca0c928fafd732..6c66298d9b228e91d07a76def819bd266ab0812d 100644
--- a/src/amd/vulkan/winsys/ps5/radv_ps5_bo.c
+++ b/src/amd/vulkan/winsys/ps5/radv_ps5_bo.c
@@ -14,7 +14,9 @@
 #include "util/os_time.h"
 #include "util/simple_mtx.h"
 #include "util/u_atomic.h"
+#include "util/u_debug.h"
 #include "util/u_dynarray.h"
+#include "util/u_math.h"
 
 /* The memory of a destroyed buffer, kept until the GPU has run every submission made before the
  * destroy. amdgpu keeps a buffer that submitted work names alive in the kernel until that work is
@@ -70,6 +72,22 @@ uint64_t radv_ps5_allocated_bytes;
  * never 0 and never reused. */
 static uint64_t radv_ps5_next_obj_id;
 
+static bool radv_ps5_stream_zero_on;
+static once_flag radv_ps5_stream_zero_once = ONCE_FLAG_INIT;
+
+static void
+radv_ps5_stream_zero_configure(void)
+{
+   radv_ps5_stream_zero_on = debug_get_bool_option("RADV_PS5_STREAM_ZERO", false);
+}
+
+bool
+radv_ps5_stream_zero(void)
+{
+   call_once(&radv_ps5_stream_zero_once, radv_ps5_stream_zero_configure);
+   return radv_ps5_stream_zero_on;
+}
+
 static VkResult
 radv_ps5_buffer_create(struct radeon_winsys *rws, uint64_t size, unsigned alignment, enum radeon_bo_domain domain,
                        enum radeon_bo_flag flags, unsigned priority, uint64_t replay_address,
@@ -132,9 +150,16 @@ radv_ps5_buffer_create(struct radeon_winsys *rws, uint64_t size, unsigned alignm
     * shadowed registers, descriptor pools and zeroInitializeDeviceMemory all
     * expect zeroes; an event's buffer is never written before its first status
     * read, dEQP-VK.api.command_buffers.submit_count_equal_zero). The GPU reads
-    * through the CPU's writes only once they are in memory. */
-   memset(bo->memory.cpu, 0, size);
-   radv_ps5_cpu_flush(bo->memory.cpu, size);
+    * through the CPU's writes only once they are in memory.
+    * RADV_PS5_STREAM_ZERO=1 writes the zeroes with non-temporal stores, which
+    * leave the range as memset and the flush do (in memory, in no cache) at
+    * one pass over it; the mapping is page-aligned and its pages cover size
+    * rounded up to 32 bytes. Without AVX2 it is memset and the flush. */
+   const uint64_t streamed = MIN2(align64(size, 32), bo->memory.bytes);
+   if (!radv_ps5_stream_zero() || !radv_ps5_cpu_zero_streamed(bo->memory.cpu, streamed)) {
+      memset(bo->memory.cpu, 0, size);
+      radv_ps5_cpu_flush(bo->memory.cpu, size);
+   }
 
    p_atomic_add(&radv_ps5_allocated_bytes, bo->memory.bytes);
    if (domain & RADEON_DOMAIN_VRAM)
diff --git a/src/amd/vulkan/winsys/ps5/radv_ps5_platform.c b/src/amd/vulkan/winsys/ps5/radv_ps5_platform.c
index 5725b684fbb321ff7552e77b878452de13afbb66..d3ed32130e8695ae766008141f09e7393fa7b2ec 100644
--- a/src/amd/vulkan/winsys/ps5/radv_ps5_platform.c
+++ b/src/amd/vulkan/winsys/ps5/radv_ps5_platform.c
@@ -25,6 +25,10 @@ extern void ps5_title_breadcrumb(const char *text) __attribute__((weak));
 #include "util/u_atomic.h"
 #include "util/u_math.h"
 
+#if defined(__AVX2__)
+#include <immintrin.h>
+#endif
+
 #if defined(__PROSPERO__)
 #include <ps5platform/agc.h>
 #include <ps5platform/kernel.h>
@@ -194,6 +198,48 @@ radv_ps5_cpu_flush(const void *address, size_t bytes)
    __builtin_ia32_mfence();
 }
 
+bool
+radv_ps5_cpu_zero_streamed(void *address, size_t bytes)
+{
+#if defined(__AVX2__)
+   if (bytes == 0)
+      return true;
+   if ((uintptr_t)address & 31)
+      return false;
+   /* Non-temporal stores go to memory through the write-combining buffers,
+    * with no read for ownership and nothing left in the caches (a line some
+    * cache held is invalidated), so what the GPU reads after the SFENCE is
+    * what memset and radv_ps5_cpu_flush would have left: zeroes in memory and
+    * no line of the range in a cache. Two 64-byte lines an iteration. */
+   __m256i *at = address;
+   const size_t blocks = bytes / 32;
+   const __m256i zero = _mm256_setzero_si256();
+   size_t i = 0;
+   for (; i + 4 <= blocks; i += 4) {
+      _mm256_stream_si256(at + i, zero);
+      _mm256_stream_si256(at + i + 1, zero);
+      _mm256_stream_si256(at + i + 2, zero);
+      _mm256_stream_si256(at + i + 3, zero);
+   }
+   for (; i < blocks; i++)
+      _mm256_stream_si256(at + i, zero);
+   const size_t tail = bytes % 32;
+   if (tail) {
+      memset((char *)address + blocks * 32, 0, tail);
+      radv_ps5_cpu_flush((char *)address + blocks * 32, tail);
+   }
+   /* Orders the streamed stores before every later store: the submission
+    * that first names the buffer, or the store that hands it to another
+    * thread. */
+   _mm_sfence();
+   return true;
+#else
+   (void)address;
+   (void)bytes;
+   return false;
+#endif
+}
+
 static bool
 radv_ps5_window_contains(uint64_t address, uint64_t bytes)
 {
diff --git a/src/amd/vulkan/winsys/ps5/radv_ps5_platform.h b/src/amd/vulkan/winsys/ps5/radv_ps5_platform.h
index 68bdeb35a7c221e20cd93c6d0616bff76f6c7f78..d697859988acaec0ef5a84954b80548360552916 100644
--- a/src/amd/vulkan/winsys/ps5/radv_ps5_platform.h
+++ b/src/amd/vulkan/winsys/ps5/radv_ps5_platform.h
@@ -98,6 +98,13 @@ uint64_t radv_ps5_memory_available_bytes(void);
  * evictions before what follows. */
 void radv_ps5_cpu_flush(const void *address, size_t bytes);
 
+/* Zeroes a range with AVX2 non-temporal stores and an SFENCE, which leaves it
+ * as memset followed by radv_ps5_cpu_flush does: zeroes in memory, no line in
+ * a cache. False, with nothing written, when the build has no AVX2 or address
+ * is not 32-byte aligned. A length that is not a multiple of 32 ends with
+ * memset and radv_ps5_cpu_flush. */
+bool radv_ps5_cpu_zero_streamed(void *address, size_t bytes);
+
 /* Submits count PM4 words at words (GPU-visible memory whose CPU lines have
  * been flushed). The words end with a packet that writes marker_value to
  * marker once they have run; the host model writes it at once. */
diff --git a/src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c b/src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c
index b12f40423c76fcb8853992882da48cbbfbbed08d..5ebec1d5cca66aa246070b151538c9cdbaf6e096 100644
--- a/src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c
+++ b/src/amd/vulkan/winsys/ps5/radv_ps5_winsys.c
@@ -641,6 +641,13 @@ radv_ps5_winsys_create(const struct radeon_info *info, struct radeon_winsys **wi
    ws->queue = queue;
    fprintf(stderr, "radv/ps5: GFX10.1 hardware workarounds %s (RADV_PS5_GFX101_WORKAROUNDS)\n",
            info->compiler_info.has_gfx101_hazards ? "on" : "off");
+   if (radv_ps5_stream_zero()) {
+#if defined(__AVX2__)
+      fprintf(stderr, "radv/ps5: new buffers zeroed with non-temporal stores (RADV_PS5_STREAM_ZERO)\n");
+#else
+      fprintf(stderr, "radv/ps5: RADV_PS5_STREAM_ZERO set, but this build has no AVX2: memset and flush\n");
+#endif
+   }
 
    ws->base.destroy = radv_ps5_winsys_destroy;
    ws->base.query_value = radv_ps5_winsys_query_value;
diff --git a/src/amd/vulkan/winsys/ps5/radv_ps5_winsys.h b/src/amd/vulkan/winsys/ps5/radv_ps5_winsys.h
index e1e43ac8202c2ce1595b2e759ae5da356c2662e9..9df18d237cf6845798de4f5221692e1a5144699f 100644
--- a/src/amd/vulkan/winsys/ps5/radv_ps5_winsys.h
+++ b/src/amd/vulkan/winsys/ps5/radv_ps5_winsys.h
@@ -183,6 +183,10 @@ VkResult radv_ps5_sync_copy_payloads(struct vk_device *device, uint32_t wait_cou
 /* Direct memory held by every winsys in the process. */
 extern uint64_t radv_ps5_allocated_bytes;
 
+/* RADV_PS5_STREAM_ZERO=1: new buffers are zeroed with non-temporal stores
+ * instead of memset and a cache flush (off by default), read once. */
+bool radv_ps5_stream_zero(void);
+
 void radv_ps5_bo_init_functions(struct radv_ps5_winsys *ws);
 void radv_ps5_cs_init_functions(struct radv_ps5_winsys *ws);
 
-- 
2.43.0

