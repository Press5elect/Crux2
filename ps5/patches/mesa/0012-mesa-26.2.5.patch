+{
+   switch (bit_size) {
+   case 32: return is_signed ? ISA_TYPE_S32 : ISA_TYPE_U32;
+   case 16: return is_signed ? ISA_TYPE_S16 : ISA_TYPE_U16;
+   case 8:  return is_signed ? ISA_TYPE_S8 : ISA_TYPE_U8;
+   default: UNREACHABLE("unsupported i2i width");
+   }
+}
