+   output = poperation->output_tensors[0];
+   weight = poperation->fcon.weight_tensor;
+
+   return weight &&
+          (weight->dims[3] != input->dims[3] ||
+           output->dims[1] != 1 ||
+           output->dims[2] != input->dims[1] * input->dims[2]);
